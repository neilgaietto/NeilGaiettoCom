---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Shikaku — NeilGaietto.com"
  description="A minimalist Shikaku logic puzzle. Divide the grid into rectangles — each number equals its rectangle's area."
>
  <div class="game-page">
    <div class="game-container">
      <header class="game-header">
        <div class="stat">
          <span class="stat-label">Level</span>
          <span id="level-display">1</span>
        </div>
        <div class="game-title">SHIKAKU</div>
        <div class="stat">
          <span class="stat-label">Moves</span>
          <span id="moves-display">0</span>
        </div>
      </header>

      <div class="canvas-wrap">
        <canvas id="gameCanvas"></canvas>
        <div id="overlay" class="overlay">
          <h2 id="overlay-title">SHIKAKU</h2>
          <p id="overlay-message">
            Divide the grid into rectangles.<br>
            Each number = that rectangle's area.
          </p>
          <div id="level-select" class="level-select">
            <button class="diff-btn" data-diff="0">Easy</button>
            <button class="diff-btn" data-diff="1">Medium</button>
            <button class="diff-btn" data-diff="2">Hard</button>
          </div>
          <p id="diff-info" class="diff-info"></p>
          <button id="overlay-btn">PLAY</button>
          <a href="/demos" class="overlay-back">← Back to demos</a>
        </div>
      </div>

      <footer class="game-footer">
        <button id="undo-btn" class="ctrl-btn">↩ Undo</button>
        <button id="reset-btn" class="ctrl-btn">↺ Reset</button>
        <a href="/demos" class="back-link">← Back</a>
      </footer>
    </div>
  </div>
</Layout>

<style is:global>
  body {
    align-items: stretch !important;
    justify-content: stretch !important;
    padding: 0;
  }
</style>

<style>
  .game-page {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    padding: 12px;
    box-sizing: border-box;
  }

  .game-container {
    display: flex;
    flex-direction: column;
    background: rgba(4, 6, 20, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 16px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      0 0 0 1px rgba(120, 80, 255, 0.18),
      0 0 60px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    overflow: hidden;
    max-width: 520px;
    width: 100%;
  }

  /* ── Header ── */
  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.02);
  }

  .game-title {
    font-size: 0.72em;
    letter-spacing: 5px;
    opacity: 0.35;
    text-transform: uppercase;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 60px;
  }

  .stat-label {
    font-size: 0.6em;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    opacity: 0.45;
  }

  #level-display, #moves-display {
    font-size: 1.1em;
    font-weight: bold;
    color: #ffd700;
  }

  /* ── Canvas ── */
  .canvas-wrap {
    position: relative;
    flex: 1;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }

  canvas {
    display: block;
    width: 100%;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    cursor: crosshair;
  }

  /* ── Overlay ── */
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: rgba(4, 6, 20, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .overlay.hidden { display: none; }

  .overlay h2 {
    font-size: 2.2em;
    margin: 0;
    letter-spacing: 6px;
    background: linear-gradient(135deg, #ff6b6b, #ffd700, #51cf66, #339af0, #cc5de8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
    filter: drop-shadow(0 0 18px rgba(255,215,0,0.4));
  }

  .overlay p {
    margin: 0;
    font-size: 0.87em;
    opacity: 0.6;
    text-align: center;
    line-height: 1.6;
    white-space: pre-line;
  }

  .level-select {
    display: flex;
    gap: 8px;
  }

  /* ── Difficulty buttons ── */
  .diff-btn {
    padding: 0.38em 1.1em;
    border-radius: 8px;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: white;
    font-family: 'Maitree', serif;
    font-size: 0.85em;
    cursor: pointer;
    transition: all 0.18s;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .diff-btn:hover {
    border-color: #ffd700;
    color: #ffd700;
    background: rgba(255, 215, 0, 0.12);
    box-shadow: 0 0 14px rgba(255, 215, 0, 0.25);
  }

  .diff-btn[data-diff="0"].active {
    border-color: #51cf66;
    color: #51cf66;
    background: rgba(81, 207, 102, 0.12);
    box-shadow: 0 0 14px rgba(81, 207, 102, 0.25);
  }

  .diff-btn[data-diff="1"].active {
    border-color: #ffd700;
    color: #ffd700;
    background: rgba(255, 215, 0, 0.12);
    box-shadow: 0 0 14px rgba(255, 215, 0, 0.25);
  }

  .diff-btn[data-diff="2"].active {
    border-color: #ff5e5e;
    color: #ff5e5e;
    background: rgba(255, 94, 94, 0.12);
    box-shadow: 0 0 14px rgba(255, 94, 94, 0.25);
  }

  .diff-info {
    font-size: 0.72em;
    opacity: 0.45;
    margin: -6px 0 0;
    min-height: 1.2em;
  }

  #overlay-btn {
    background: rgba(255, 215, 0, 0.13);
    border: 1.5px solid rgba(255, 215, 0, 0.6);
    color: #ffd700;
    font-family: 'Maitree', serif;
    font-size: 0.95em;
    letter-spacing: 3px;
    padding: 0.55em 2.2em;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
    text-transform: uppercase;
  }

  #overlay-btn:hover {
    background: rgba(255, 215, 0, 0.26);
    box-shadow: 0 0 22px rgba(255, 215, 0, 0.35);
  }

  .overlay-back {
    font-size: 0.78em;
    opacity: 0.4;
    color: white;
    font-style: italic;
    text-decoration: none;
  }

  .overlay-back:hover { opacity: 0.7; }

  /* ── Footer ── */
  .game-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
    min-height: 38px;
    background: rgba(255, 255, 255, 0.02);
  }

  .ctrl-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.65);
    font-family: 'Maitree', serif;
    font-size: 0.78em;
    padding: 0.3em 0.85em;
    border-radius: 6px;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: all 0.15s;
  }

  .ctrl-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: white;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .back-link {
    font-size: 0.78em;
    opacity: 0.4;
    color: white;
    font-style: italic;
    text-decoration: none;
    min-width: 60px;
    text-align: right;
  }

  .back-link:hover { opacity: 0.7; }

  @media screen and (max-width: 480px) {
    .game-page { padding: 6px; }
    .game-header, .game-footer { padding: 7px 12px; }
  }

  @media screen and (orientation: landscape) and (max-height: 520px) {
    .game-header, .game-footer { padding: 4px 14px; min-height: 28px; }
    .game-title { display: none; }
  }
</style>

<script>
// ── TYPES ──
interface Clue { row: number; col: number; value: number; }
interface LevelDef { rows: number; cols: number; clues: Clue[]; label: string; }
interface Rect { r1: number; c1: number; r2: number; c2: number; colorIdx: number; }
interface DragState { r1: number; c1: number; r2: number; c2: number; }
interface DifficultyConfig {
  name: string;
  minRows: number; maxRows: number;
  minCols: number; maxCols: number;
  maxRectW: number; maxRectH: number;
  // rolls to take the max of when picking rect dimensions; >1 biases toward larger sizes
  bias: number;
}

// ── COLOR PALETTE ──
const PALETTE = [
  { bg: 'rgba(255,94,94,0.38)',   border: '#ff5e5e',  glow: '#ff5e5e'  },
  { bg: 'rgba(255,165,0,0.38)',   border: '#ffa500',  glow: '#ffa500'  },
  { bg: 'rgba(255,225,0,0.38)',   border: '#ffe100',  glow: '#ffe100'  },
  { bg: 'rgba(81,207,102,0.38)',  border: '#51cf66',  glow: '#51cf66'  },
  { bg: 'rgba(0,229,255,0.38)',   border: '#00e5ff',  glow: '#00e5ff'  },
  { bg: 'rgba(82,148,255,0.38)',  border: '#5294ff',  glow: '#5294ff'  },
  { bg: 'rgba(190,120,255,0.38)', border: '#be78ff',  glow: '#be78ff'  },
  { bg: 'rgba(255,128,171,0.38)', border: '#ff80ab',  glow: '#ff80ab'  },
  { bg: 'rgba(100,255,218,0.38)', border: '#64ffda',  glow: '#64ffda'  },
  { bg: 'rgba(255,182,100,0.38)', border: '#ffb664',  glow: '#ffb664'  },
];

// ── DIFFICULTY CONFIG ──
// Easy:   small grids, large rects → few pieces, obvious solutions
// Medium: medium grids, moderate rects → more pieces, moderate challenge
// Hard:   large grids, small rects → many pieces, complex solutions
const DIFFICULTIES: DifficultyConfig[] = [
  { name: 'EASY',   minRows: 4, maxRows: 5,  minCols: 4, maxCols: 5,  maxRectW: 5, maxRectH: 5, bias: 1 },
  { name: 'MEDIUM', minRows: 6, maxRows: 7,  minCols: 6, maxCols: 7,  maxRectW: 3, maxRectH: 3, bias: 1 },
  { name: 'HARD',   minRows: 8, maxRows: 10, minCols: 8, maxCols: 10, maxRectW: 3, maxRectH: 3, bias: 2 },
];

// ── SEEDED RNG ──
// Produces a deterministic pseudo-random sequence from a numeric seed,
// so the same difficulty+level always generates the same puzzle.
function seededRandom(seed: number): () => number {
  let s = (seed ^ 0xdeadbeef) >>> 0;
  return () => {
    s = Math.imul(s ^ (s >>> 16), 0x45d9f3b);
    s = Math.imul(s ^ (s >>> 16), 0x45d9f3b);
    s ^= s >>> 16;
    return (s >>> 0) / 0x100000000;
  };
}

// ── LEVEL GENERATOR ──
// Fills the grid row-by-row, placing random-sized rectangles that fit
// without overlapping. A clue number is placed at the center of each
// rectangle, which maximally constrains the solver.
function generateShikaku(
  rows: number, cols: number,
  maxW: number, maxH: number,
  rng: () => number,
  bias = 1,
): LevelDef {
  // With bias > 1, pick the max of `bias` uniform draws, skewing toward larger rectangles
  // and reducing the chance of 1×1 fragments on harder difficulties.
  const pickSize = (n: number) => {
    if (n <= 1) return 1;
    let r = rng();
    for (let i = 1; i < bias; i++) r = Math.max(r, rng());
    return 1 + Math.floor(r * n);
  };

  const grid = Array.from({ length: rows }, () => new Array<number>(cols).fill(-1));
  const rects: { r1: number; c1: number; r2: number; c2: number }[] = [];

  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (grid[r][c] !== -1) continue;

      // Contiguous free cells to the right in this row
      let availW = 0;
      while (c + availW < cols && grid[r][c + availW] === -1) availW++;
      const w = pickSize(Math.min(availW, maxW));

      // Rows downward where all w columns are free
      let availH = 0;
      for (let dr = 0; r + dr < rows; dr++) {
        let ok = true;
        for (let dc = 0; dc < w; dc++) {
          if (grid[r + dr][c + dc] !== -1) { ok = false; break; }
        }
        if (!ok) break;
        availH = dr + 1;
      }
      const h = pickSize(Math.min(availH, maxH));

      const id = rects.length;
      for (let dr = 0; dr < h; dr++)
        for (let dc = 0; dc < w; dc++)
          grid[r + dr][c + dc] = id;

      rects.push({ r1: r, c1: c, r2: r + h - 1, c2: c + w - 1 });
    }
  }

  const clues: Clue[] = rects.map(rect => ({
    row: Math.floor((rect.r1 + rect.r2) / 2),
    col: Math.floor((rect.c1 + rect.c2) / 2),
    value: (rect.r2 - rect.r1 + 1) * (rect.c2 - rect.c1 + 1),
  }));

  return { rows, cols, clues, label: `${rows}×${cols}` };
}

function buildLevel(diffIdx: number, lvlNum: number): LevelDef {
  const diff = DIFFICULTIES[diffIdx];
  const seed = diffIdx * 1000000 + lvlNum;
  const rng  = seededRandom(seed);
  const rows = diff.minRows + Math.floor(rng() * (diff.maxRows - diff.minRows + 1));
  const cols = diff.minCols + Math.floor(rng() * (diff.maxCols - diff.minCols + 1));
  return generateShikaku(rows, cols, diff.maxRectW, diff.maxRectH, rng, diff.bias);
}

// ── CANVAS SETUP ──
const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;
const ctx    = canvas.getContext('2d')!;

function sizeCanvas() {
  const wrap = canvas.parentElement!;
  const w = wrap.clientWidth;
  const maxH = window.innerHeight - 130;
  canvas.width  = w;
  canvas.height = Math.min(Math.round(w * 1.05), maxH);
}

// ── STATE ──
let difficultyIdx  = 0;
let levelNumber    = 1;
let currentLevel   = buildLevel(0, 1);
let placedRects: Rect[] = [];
let history: Rect[][] = [];
let moves = 0;
let colorCounter = 0;
let phase: 'menu' | 'playing' | 'won' = 'menu';
let drag: DragState | null = null;
let dragIsMove = false;
let flashInvalid = 0;
let winPulse = 0;
let bestLevels = [0, 0, 0]; // highest completed level per difficulty index

// ── PROGRESS PERSISTENCE ──
function loadProgress() {
  try {
    const raw = localStorage.getItem('shikaku-progress');
    if (raw) {
      const data = JSON.parse(raw) as { bestLevels?: number[]; lastDiff?: number };
      if (Array.isArray(data.bestLevels)) bestLevels = data.bestLevels;
      if (typeof data.lastDiff === 'number' && data.lastDiff >= 0 && data.lastDiff < DIFFICULTIES.length) {
        difficultyIdx = data.lastDiff;
      }
    }
  } catch {}
  // Resume at the next unsolved level for the restored difficulty
  levelNumber = bestLevels[difficultyIdx] > 0 ? bestLevels[difficultyIdx] + 1 : 1;
  currentLevel = buildLevel(difficultyIdx, levelNumber);
}

function saveProgress() {
  try {
    localStorage.setItem('shikaku-progress', JSON.stringify({ bestLevels, lastDiff: difficultyIdx }));
  } catch {}
}

// ── GRID GEOMETRY ──
function cellSize(): number {
  const pad = 24;
  return Math.max(1, Math.floor(Math.min(
    (canvas.width  - pad * 2) / currentLevel.cols,
    (canvas.height - pad * 2) / currentLevel.rows,
  )));
}

function gridOffset(): { ox: number; oy: number } {
  const cs = cellSize();
  return {
    ox: Math.floor((canvas.width  - cs * currentLevel.cols) / 2),
    oy: Math.floor((canvas.height - cs * currentLevel.rows) / 2),
  };
}

function cellFromPoint(px: number, py: number): { r: number; c: number } | null {
  const { ox, oy } = gridOffset();
  const cs = cellSize();
  const c = Math.floor((px - ox) / cs);
  const r = Math.floor((py - oy) / cs);
  if (r < 0 || r >= currentLevel.rows || c < 0 || c >= currentLevel.cols) return null;
  return { r, c };
}

function canvasPos(e: MouseEvent | Touch): { x: number; y: number } {
  const rect = canvas.getBoundingClientRect();
  const sx = canvas.width  / rect.width;
  const sy = canvas.height / rect.height;
  return {
    x: (e.clientX - rect.left) * sx,
    y: (e.clientY - rect.top)  * sy,
  };
}

// ── VALIDATION ──
function normalise(d: DragState) {
  return {
    r1: Math.min(d.r1, d.r2), c1: Math.min(d.c1, d.c2),
    r2: Math.max(d.r1, d.r2), c2: Math.max(d.c1, d.c2),
  };
}

function rectsOverlap(a: Rect, b: { r1: number; c1: number; r2: number; c2: number }): boolean {
  return a.r1 <= b.r2 && a.r2 >= b.r1 && a.c1 <= b.c2 && a.c2 >= b.c1;
}

function validateRect(r1: number, c1: number, r2: number, c2: number): boolean {
  const area = (r2 - r1 + 1) * (c2 - c1 + 1);
  const inside = currentLevel.clues.filter(cl =>
    cl.row >= r1 && cl.row <= r2 && cl.col >= c1 && cl.col <= c2,
  );
  return inside.length === 1 && area === inside[0].value;
}

function checkWin(): boolean {
  const total = currentLevel.rows * currentLevel.cols;
  const covered = new Set<string>();
  for (const rect of placedRects) {
    const { r1, c1, r2, c2 } = rect;
    const area = (r2 - r1 + 1) * (c2 - c1 + 1);
    const inside = currentLevel.clues.filter(cl =>
      cl.row >= r1 && cl.row <= r2 && cl.col >= c1 && cl.col <= c2,
    );
    if (inside.length !== 1 || area !== inside[0].value) return false;
    for (let r = r1; r <= r2; r++)
      for (let c = c1; c <= c2; c++)
        covered.add(`${r},${c}`);
  }
  return covered.size === total;
}

// ── SOUND ──
let audioCtx: AudioContext | null = null;
function tone(freq: number, dur: number, type: OscillatorType = 'sine', vol = 0.12) {
  try {
    if (!audioCtx) audioCtx = new AudioContext();
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.connect(g); g.connect(audioCtx.destination);
    o.type = type; o.frequency.value = freq;
    g.gain.setValueAtTime(vol, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
    o.start(); o.stop(audioCtx.currentTime + dur);
  } catch {}
}
function soundPlace()   { tone(480, 0.09); }
function soundInvalid() { tone(180, 0.14, 'sawtooth', 0.07); }
function soundUndo()    { tone(330, 0.08); }
function soundWin()     {
  [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => tone(f, 0.25, 'sine', 0.1), i * 90));
}

// ── HUD ──
const elLevel = document.getElementById('level-display')!;
const elMoves = document.getElementById('moves-display')!;

function updateHUD() {
  elLevel.textContent = String(levelNumber);
  elMoves.textContent = String(moves);
}

// ── OVERLAY ──
const overlay    = document.getElementById('overlay')!;
const elTitle    = document.getElementById('overlay-title')!;
const elMsg      = document.getElementById('overlay-message')!;
const elBtn      = document.getElementById('overlay-btn')!;
const diffBtns   = document.querySelectorAll<HTMLButtonElement>('.diff-btn');
const levelSel   = document.getElementById('level-select')!;
const elDiffInfo = document.getElementById('diff-info')!;

function updateDiffInfo() {
  const best = bestLevels[difficultyIdx];
  elDiffInfo.textContent = best > 0 ? `Best: Level ${best}` : 'No levels completed yet';
}

function showOverlay(title: string, msg: string, btn: string, showDiffs = false) {
  overlay.classList.remove('hidden');
  elTitle.textContent = title;
  elMsg.textContent   = msg;
  elBtn.textContent   = btn;
  levelSel.style.display   = showDiffs ? 'flex' : 'none';
  elDiffInfo.style.display = showDiffs ? 'block' : 'none';
  refreshDiffBtns();
  updateDiffInfo();
}

function hideOverlay() { overlay.classList.add('hidden'); }

function refreshDiffBtns() {
  diffBtns.forEach((btn, i) => {
    btn.classList.toggle('active', i === difficultyIdx);
  });
}

diffBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    difficultyIdx = Number(btn.dataset.diff);
    levelNumber   = bestLevels[difficultyIdx] > 0 ? bestLevels[difficultyIdx] + 1 : 1;
    currentLevel  = buildLevel(difficultyIdx, levelNumber);
    refreshDiffBtns();
    updateDiffInfo();
    updateHUD();
  });
});

elBtn.addEventListener('click', () => {
  if (phase === 'menu' || phase === 'won') startLevel();
});

// ── GAME FLOW ──
function startLevel() {
  currentLevel = buildLevel(difficultyIdx, levelNumber);
  placedRects  = [];
  history      = [];
  moves        = 0;
  colorCounter = 0;
  drag         = null;
  phase        = 'playing';
  winPulse     = 0;
  hideOverlay();
  updateHUD();
}

function handleWin() {
  phase    = 'won';
  winPulse = 1;
  bestLevels[difficultyIdx] = Math.max(bestLevels[difficultyIdx], levelNumber);
  saveProgress();
  soundWin();
  const completed = levelNumber;
  levelNumber++;
  currentLevel = buildLevel(difficultyIdx, levelNumber);
  setTimeout(() => showOverlay(
    'SOLVED!',
    `Level ${completed} complete!\nReady for level ${levelNumber}?`,
    'NEXT LEVEL',
    true,
  ), 600);
}

// ── INPUT ──
function onPointerDown(px: number, py: number) {
  if (phase !== 'playing') return;
  const cell = cellFromPoint(px, py);
  if (!cell) return;
  drag = { r1: cell.r, c1: cell.c, r2: cell.r, c2: cell.c };
  dragIsMove = false;
}

function onPointerMove(px: number, py: number) {
  if (!drag || phase !== 'playing') return;
  const cell = cellFromPoint(px, py);
  if (!cell) return;
  if (cell.r !== drag.r1 || cell.c !== drag.c1) dragIsMove = true;
  drag.r2 = cell.r;
  drag.c2 = cell.c;
}

function onPointerUp(px: number, py: number) {
  if (!drag || phase !== 'playing') { drag = null; return; }
  const { r1, c1, r2, c2 } = normalise(drag);
  drag = null;

  if (!dragIsMove) {
    // Single-cell tap: remove existing rect, or place a 1×1 if there's a value=1 clue
    const existingIdx = placedRects.findIndex(rc =>
      r1 >= rc.r1 && r1 <= rc.r2 && c1 >= rc.c1 && c1 <= rc.c2,
    );
    if (existingIdx !== -1) {
      history.push(placedRects.map(r => ({ ...r })));
      placedRects.splice(existingIdx, 1);
      moves++;
      updateHUD();
      soundUndo();
    } else if (currentLevel.clues.some(cl => cl.row === r1 && cl.col === c1 && cl.value === 1)) {
      history.push(placedRects.map(r => ({ ...r })));
      placedRects.push({ r1, c1, r2: r1, c2: c1, colorIdx: colorCounter % PALETTE.length });
      colorCounter++;
      moves++;
      updateHUD();
      soundPlace();
      if (checkWin()) handleWin();
    }
    return;
  }

  if (validateRect(r1, c1, r2, c2)) {
    history.push(placedRects.map(r => ({ ...r })));
    placedRects = placedRects.filter(rc => !rectsOverlap(rc, { r1, c1, r2, c2 }));
    placedRects.push({ r1, c1, r2, c2, colorIdx: colorCounter % PALETTE.length });
    colorCounter++;
    moves++;
    updateHUD();
    soundPlace();
    if (checkWin()) handleWin();
  } else {
    flashInvalid = 18;
    soundInvalid();
  }
}

// Mouse
canvas.addEventListener('mousedown',  e => { e.preventDefault(); const p = canvasPos(e); onPointerDown(p.x, p.y); });
canvas.addEventListener('mousemove',  e => { const p = canvasPos(e); onPointerMove(p.x, p.y); });
canvas.addEventListener('mouseup',    e => { const p = canvasPos(e); onPointerUp(p.x, p.y); });
canvas.addEventListener('mouseleave', () => { drag = null; });

// Touch
canvas.addEventListener('touchstart',  e => { e.preventDefault(); const p = canvasPos(e.touches[0]); onPointerDown(p.x, p.y); }, { passive: false });
canvas.addEventListener('touchmove',   e => { e.preventDefault(); const p = canvasPos(e.touches[0]); onPointerMove(p.x, p.y); }, { passive: false });
canvas.addEventListener('touchend',    e => { e.preventDefault(); const t = e.changedTouches[0]; const p = canvasPos(t); onPointerUp(p.x, p.y); }, { passive: false });
canvas.addEventListener('touchcancel', () => { drag = null; dragIsMove = false; });

// Controls
document.getElementById('undo-btn')!.addEventListener('click', () => {
  if (history.length === 0 || phase !== 'playing') return;
  placedRects = history.pop()!;
  moves++;
  updateHUD();
  soundUndo();
});

document.getElementById('reset-btn')!.addEventListener('click', () => {
  if (phase !== 'playing') return;
  if (placedRects.length > 0) {
    history.push(placedRects.map(r => ({ ...r })));
    placedRects = [];
    moves++;
    updateHUD();
  }
});

// ── DRAWING ──
function drawBackground() {
  ctx.fillStyle = 'rgba(5, 7, 22, 0.95)';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
}

function drawGrid() {
  const cs = cellSize();
  const { ox, oy } = gridOffset();
  const gw = cs * currentLevel.cols;
  const gh = cs * currentLevel.rows;

  // Grid cell backgrounds
  for (let r = 0; r < currentLevel.rows; r++) {
    for (let c = 0; c < currentLevel.cols; c++) {
      const x = ox + c * cs;
      const y = oy + r * cs;
      ctx.fillStyle = (r + c) % 2 === 0 ? 'rgba(255,255,255,0.025)' : 'rgba(255,255,255,0.012)';
      ctx.fillRect(x + 1, y + 1, cs - 1, cs - 1);
    }
  }

  // Grid lines
  ctx.strokeStyle = 'rgba(255,255,255,0.18)';
  ctx.lineWidth   = 1;
  for (let r = 0; r <= currentLevel.rows; r++) {
    const y = oy + r * cs;
    ctx.beginPath(); ctx.moveTo(ox, y); ctx.lineTo(ox + gw, y); ctx.stroke();
  }
  for (let c = 0; c <= currentLevel.cols; c++) {
    const x = ox + c * cs;
    ctx.beginPath(); ctx.moveTo(x, oy); ctx.lineTo(x, oy + gh); ctx.stroke();
  }

  // Outer border
  ctx.strokeStyle = 'rgba(255,255,255,0.4)';
  ctx.lineWidth = 2;
  ctx.strokeRect(ox, oy, gw, gh);
}

function drawRect(r1: number, c1: number, r2: number, c2: number, color: typeof PALETTE[0], alpha = 1) {
  const cs = cellSize();
  const { ox, oy } = gridOffset();
  const pad  = 2;
  const x    = ox + c1 * cs + pad;
  const y    = oy + r1 * cs + pad;
  const w    = (c2 - c1 + 1) * cs - pad * 2;
  const h    = (r2 - r1 + 1) * cs - pad * 2;
  const rad  = Math.min(6, cs * 0.18);

  ctx.save();
  ctx.globalAlpha = alpha;

  // Fill
  ctx.fillStyle = color.bg;
  ctx.shadowColor = color.glow;
  ctx.shadowBlur  = 12;
  roundRect(x, y, w, h, rad);
  ctx.fill();

  // Border
  ctx.shadowBlur  = 8;
  ctx.strokeStyle = color.border;
  ctx.lineWidth   = 2;
  roundRect(x, y, w, h, rad);
  ctx.stroke();

  // Subtle inner sheen
  ctx.shadowBlur  = 0;
  ctx.globalAlpha = alpha * 0.18;
  ctx.fillStyle   = 'white';
  roundRect(x + 3, y + 3, w - 6, Math.min(h - 6, cs * 0.28), rad * 0.6);
  ctx.fill();

  ctx.restore();
}

function drawPlacedRects() {
  for (const rect of placedRects) {
    drawRect(rect.r1, rect.c1, rect.r2, rect.c2, PALETTE[rect.colorIdx % PALETTE.length]);
  }
}

function drawDragPreview() {
  if (!drag || phase !== 'playing') return;
  const { r1, c1, r2, c2 } = normalise(drag);
  const isValid = validateRect(r1, c1, r2, c2);
  const flash   = flashInvalid > 0;

  const previewColor = flash
    ? { bg: 'rgba(255,60,60,0.25)',  border: '#ff4040', glow: '#ff4040' }
    : isValid
      ? { bg: 'rgba(100,255,120,0.22)', border: '#64ff82', glow: '#64ff82' }
      : { bg: 'rgba(255,255,255,0.08)', border: 'rgba(255,255,255,0.3)', glow: 'transparent' };

  drawRect(r1, c1, r2, c2, previewColor, flash ? 0.5 + 0.5 * Math.sin(Date.now() / 60) : 0.9);
}

function drawClues() {
  const cs = cellSize();
  const { ox, oy } = gridOffset();
  const fontSize = Math.max(10, Math.round(cs * 0.42));

  ctx.font      = `bold ${fontSize}px 'Maitree', serif`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  for (const cl of currentLevel.clues) {
    const x = ox + cl.col * cs + cs / 2;
    const y = oy + cl.row * cs + cs / 2;

    // Find if this clue is inside a placed rect
    const inRect = placedRects.find(rc =>
      cl.row >= rc.r1 && cl.row <= rc.r2 && cl.col >= rc.c1 && cl.col <= rc.c2,
    );

    if (inRect) {
      const col = PALETTE[inRect.colorIdx % PALETTE.length];
      ctx.fillStyle  = col.border;
      ctx.shadowColor = col.glow;
    } else {
      ctx.fillStyle  = '#ffd700';
      ctx.shadowColor = '#ffd700';
    }

    ctx.shadowBlur = 10;
    ctx.fillText(String(cl.value), x, y);
    ctx.shadowBlur = 0;

    // Small dot indicator
    ctx.fillStyle = ctx.fillStyle;
    ctx.globalAlpha = 0.5;
    ctx.beginPath();
    ctx.arc(x, y + fontSize * 0.62, 2, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }
}

function drawWinOverlay() {
  if (phase !== 'won' || winPulse <= 0) return;
  const p = winPulse;
  ctx.save();
  ctx.globalAlpha = p * 0.22;
  const grad = ctx.createRadialGradient(
    canvas.width / 2, canvas.height / 2, 0,
    canvas.width / 2, canvas.height / 2, Math.max(canvas.width, canvas.height) * 0.7,
  );
  grad.addColorStop(0,   'rgba(255,255,255,0.6)');
  grad.addColorStop(0.4, 'rgba(100,200,255,0.3)');
  grad.addColorStop(1,   'rgba(0,0,0,0)');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.restore();
}

function roundRect(x: number, y: number, w: number, h: number, r: number) {
  const m = Math.min(r, w / 2, h / 2);
  ctx.beginPath();
  ctx.moveTo(x + m, y);
  ctx.lineTo(x + w - m, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + m);
  ctx.lineTo(x + w, y + h - m);
  ctx.quadraticCurveTo(x + w, y + h, x + w - m, y + h);
  ctx.lineTo(x + m, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - m);
  ctx.lineTo(x, y + m);
  ctx.quadraticCurveTo(x, y, x + m, y);
  ctx.closePath();
}

// ── RENDER LOOP ──
let raf = 0;

function frame() {
  raf = requestAnimationFrame(frame);
  if (flashInvalid > 0) flashInvalid--;
  if (winPulse > 0) winPulse = Math.max(0, winPulse - 0.025);

  drawBackground();
  if (phase !== 'menu') {
    drawGrid();
    drawPlacedRects();
    drawDragPreview();
    drawClues();
    drawWinOverlay();
  }
}

// ── RESIZE ──
window.addEventListener('resize', () => {
  sizeCanvas();
});

// ── BOOT ──
loadProgress();
sizeCanvas();
updateHUD();
showOverlay(
  'SHIKAKU',
  'Divide the grid into rectangles.\nEach number = that rectangle\'s area.\n\nDrag to draw · Tap to erase',
  'PLAY',
  true,
);
frame();
</script>
