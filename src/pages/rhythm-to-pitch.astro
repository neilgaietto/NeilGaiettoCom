---
import Layout from '../layouts/Layout.astro';

// Four voices, each with its own timbre and stereo seat so dense polyrhythms
// stay legible instead of collapsing into one grey texture.
const VOICES = [
  { key: 0, name: 'Voice A', role: 'Root',    pan: '50% L', band: '700 Hz'  },
  { key: 1, name: 'Voice B', role: 'Third',   pan: '20% L', band: '1.1 kHz' },
  { key: 2, name: 'Voice C', role: 'Fifth',   pan: '20% R', band: '1.6 kHz' },
  { key: 3, name: 'Voice D', role: 'Seventh', pan: '50% R', band: '2.2 kHz' },
];

// `parts` is the chord written as whole numbers over a shared root, so voice
// n's ratio is parts[n] / parts[0]. Covers intervals, triads and 7th chords
// with one shape.
const PRESETS = [
  { label: 'Unison',        display: '1:1',        parts: [1, 1] },
  { label: 'Major 2nd',     display: '9:8',        parts: [8, 9] },
  { label: 'Minor 3rd',     display: '6:5',        parts: [5, 6] },
  { label: 'Major 3rd',     display: '5:4',        parts: [4, 5] },
  { label: 'Perfect 4th',   display: '4:3',        parts: [3, 4] },
  { label: 'Perfect 5th',   display: '3:2',        parts: [2, 3] },
  { label: 'Minor 6th',     display: '8:5',        parts: [5, 8] },
  { label: 'Major 6th',     display: '5:3',        parts: [3, 5] },
  { label: 'Octave',        display: '2:1',        parts: [1, 2] },
  { label: 'Major triad',   display: '4:5:6',      parts: [4, 5, 6] },
  { label: 'Minor triad',   display: '10:12:15',   parts: [10, 12, 15] },
  { label: 'Harmonic 7th',  display: '4:5:6:7',    parts: [4, 5, 6, 7] },
  { label: 'Major 7th',     display: '8:10:12:15', parts: [8, 10, 12, 15] },
];

const FREQ_PRESETS = [
  { label: 'Slow polyrhythm', sub: '2 Hz',        hz: 2 },
  { label: 'Flutter',         sub: '18 Hz',       hz: 18 },
  { label: 'Low bass',        sub: 'A2 · 110 Hz', hz: 110 },
  { label: 'Middle tone',     sub: 'A3 · 220 Hz', hz: 220 },
];

// The slider maps 1 Hz → 440 Hz logarithmically, so this is where the
// ~20 Hz rhythm/pitch boundary lands along the track.
const BOUNDARY_PCT = (Math.log(20) / Math.log(440)) * 100;
---

<Layout
  title="Rhythm to Pitch — NeilGaietto.com"
  description="Sweep up to four just-intonation voices past 20 Hz and hear polyrhythms fuse into chords."
>
  <div class="rp-page">
    <div class="rp-shell">
      <header class="rp-head">
        <h1>Rhythm <span class="arrow">→</span> Pitch</h1>
        <div id="modeBadge" class="rp-badge is-rhythm">Rhythm</div>
      </header>

      <p class="rp-lede">
        Up to four pulse trains over a shared root. Under ~20 Hz you hear a polyrhythm;
        speed the same whole-number ratios past that line and they fuse into a chord.
        A 4:5:6 polyrhythm <em>is</em> a major triad. Detune a voice by a hair and the
        rings start to slip while the tone beats.
      </p>

      <div class="rp-stage">
        <canvas id="rings" class="rp-rings" aria-label="Polyrhythm rings"></canvas>
        <div class="rp-summary">
          <div class="rp-chord">
            <div class="rp-chord-name" id="chordName">Major triad</div>
            <div class="rp-chord-sub" id="chordSub">4:5:6 · 3 voices</div>
          </div>
          <div class="rp-chord">
            <div class="rp-chord-label">Sounding</div>
            <div class="rp-chord-notes" id="chordNotes">—</div>
          </div>
          <div class="rp-chord">
            <div class="rp-chord-label">Common cycle</div>
            <div class="rp-chord-notes" id="cycleInfo">—</div>
          </div>
        </div>
      </div>

      <canvas id="strip" class="rp-strip" aria-label="Waveform and trigger display"></canvas>
      <div class="rp-strip-caption" id="stripCaption">Separate clicks on a timeline</div>

      <div class="rp-controls">
        <div class="rp-row">
          <button id="startBtn" class="rp-start" type="button">▶ Start engine</button>
          <button id="syncBtn" class="rp-sync" type="button">⟲ Sync phase</button>
          <div class="rp-vol">
            <label for="volSlider">Volume</label>
            <input id="volSlider" type="range" min="0" max="100" value="70" step="1">
          </div>
        </div>

        <div class="rp-block">
          <div class="rp-block-head">
            <span>Tempo / frequency</span>
            <span class="rp-value" id="freqLabel">2.00 Hz</span>
          </div>
          <div class="rp-slider-wrap">
            <div class="rp-boundary" style={`left:${BOUNDARY_PCT}%`}></div>
            <input id="freqSlider" type="range" min="0" max="1000" value="113.9" step="0.1"
                   aria-label="Base pulse frequency">
          </div>
          <div class="rp-scale">
            <span>1 Hz</span>
            <span class="rp-scale-mark" style={`left:${BOUNDARY_PCT}%`}>20 Hz · rhythm becomes pitch</span>
            <span>440 Hz</span>
          </div>
          <div class="rp-chips">
            {FREQ_PRESETS.map((p) => (
              <button class="rp-chip" type="button" data-hz={p.hz} aria-pressed="false">
                <span class="chip-main">{p.label}</span>
                <span class="chip-sub">{p.sub}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="rp-block">
          <div class="rp-block-head">
            <span>Active voices</span>
            <span class="rp-value" id="countLabel">3</span>
          </div>
          <div class="rp-chips">
            {[2, 3, 4].map((n) => (
              <button class="rp-chip rp-chip-count" type="button" data-count={n} aria-pressed="false">
                <span class="chip-main">{n} voices</span>
              </button>
            ))}
          </div>
        </div>

        <div class="rp-block">
          <div class="rp-block-head"><span>Chord &amp; interval presets</span></div>
          <div class="rp-chips rp-chips-ratio">
            {PRESETS.map((r) => (
              <button class="rp-chip rp-chip-preset" type="button" aria-pressed="false"
                      data-parts={r.parts.join(',')} data-label={r.label}>
                <span class="chip-main">{r.label}</span>
                <span class="chip-sub">{r.display}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="rp-block">
          <div class="rp-block-head">
            <span>Voices</span>
            <span class="rp-hint">ratio is a whole-number fraction of the root; detune slides it off</span>
          </div>
          <div class="rp-voices">
            {VOICES.map((v) => (
              <div class={`rp-vcard v${v.key}`} data-voice={v.key}>
                <div class="rp-vhead">
                  <span class="rp-dot"></span>
                  <span class="rp-vname">{v.name}</span>
                  <span class="rp-vmeta">{v.role} · {v.pan} · {v.band}</span>
                  <span class="rp-vtoggles">
                    <button class="rp-toggle" type="button" data-act="on" data-voice={v.key}
                            aria-pressed="false">On</button>
                    <button class="rp-toggle" type="button" data-act="mute" data-voice={v.key}
                            aria-pressed="false">Mute</button>
                    <button class="rp-toggle" type="button" data-act="solo" data-voice={v.key}
                            aria-pressed="false">Solo</button>
                  </span>
                </div>

                <div class="rp-vread">
                  <span class="rp-vprimary" id={`prim${v.key}`}>—</span>
                  <span class="rp-vsecondary" id={`sec${v.key}`}>—</span>
                </div>

                <div class="rp-vctrls">
                  <label class="rp-frac">
                    <span class="rp-frac-label">Ratio</span>
                    <input class="rp-int" type="number" min="1" max="64" step="1" value="1"
                           data-part="num" data-voice={v.key} aria-label={`${v.name} numerator`}>
                    <span class="rp-frac-bar">:</span>
                    <input class="rp-int" type="number" min="1" max="64" step="1" value="1"
                           data-part="den" data-voice={v.key} aria-label={`${v.name} denominator`}>
                  </label>
                  <div class="rp-detune">
                    <label class="rp-frac-label" for={`dt${v.key}`}>
                      Detune <span id={`det${v.key}`}>+0.000</span>
                    </label>
                    <input class="rp-dt" id={`dt${v.key}`} type="range"
                           min="-0.05" max="0.05" step="0.001" value="0"
                           data-voice={v.key} aria-label={`${v.name} detune`}>
                    <button class="rp-dtreset" type="button" data-voice={v.key} disabled
                            aria-label={`Reset ${v.name} detune to zero`}
                            title="Reset detune to zero">⟲</button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <a href="/demos" class="rp-back">← Back to demos</a>
    </div>
  </div>
</Layout>

<style is:global>
  body {
    align-items: stretch !important;
    justify-content: stretch !important;
    background-color: #05070f !important;
  }
</style>

<style>
  .rp-page {
    --v0: #5ad1ff;
    --v1: #ffb020;
    --v2: #b98cff;
    --v3: #4ee39b;
    --ink: #e8ecf5;
    --dim: rgba(232, 236, 245, 0.55);
    --faint: rgba(232, 236, 245, 0.32);
    --edge: rgba(255, 255, 255, 0.11);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    padding: 20px 12px 40px;
  }

  .rp-shell {
    width: 100%;
    max-width: 760px;
    background: rgba(4, 7, 20, 0.86);
    border: 1px solid var(--edge);
    border-radius: 16px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 0 0 1px rgba(90, 209, 255, 0.1), 0 24px 70px rgba(0, 0, 0, 0.7);
    padding: 22px 22px 18px;
    color: var(--ink);
    text-align: left;
  }

  .rp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .rp-head h1 { font-size: 1.5em; margin: 0; }
  .rp-head .arrow { color: var(--v0); opacity: 0.8; }

  .rp-badge {
    font-size: 0.62em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.42em 0.85em;
    border-radius: 999px;
    border: 1px solid currentColor;
    white-space: nowrap;
    transition: color 0.3s, background 0.3s;
  }

  .rp-badge.is-rhythm { color: var(--v0); background: rgba(90, 209, 255, 0.1); }
  .rp-badge.is-pitch  { color: var(--v1); background: rgba(255, 176, 32, 0.12); }

  .rp-lede {
    font-size: 0.88em;
    line-height: 1.55;
    color: var(--dim);
    margin: 0.7em 0 1.3em;
  }

  /* ── Stage ── */
  .rp-stage { display: flex; gap: 18px; align-items: stretch; }

  .rp-rings {
    display: block;
    width: 280px;
    height: 280px;
    flex: 0 0 auto;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--edge);
  }

  .rp-summary {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .rp-chord {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--edge);
    border-radius: 10px;
    padding: 10px 12px;
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .rp-chord-name { font-size: 1.15em; }

  .rp-chord-sub,
  .rp-chord-notes {
    font-size: 0.8em;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
    margin-top: 0.15em;
    overflow-wrap: anywhere;
  }

  .rp-chord-label {
    font-size: 0.66em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* ── Strip ── */
  .rp-strip {
    display: block;
    width: 100%;
    height: 170px;
    margin-top: 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--edge);
  }

  .rp-strip-caption {
    font-size: 0.72em;
    color: var(--faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 7px 2px 0;
  }

  /* ── Controls ── */
  .rp-controls { margin-top: 18px; display: flex; flex-direction: column; gap: 14px; }

  .rp-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .rp-start {
    font-family: inherit;
    font-size: 0.95em;
    color: #04121a;
    background: linear-gradient(135deg, var(--v0), #9ae6ff);
    border: none;
    border-radius: 10px;
    padding: 0.7em 1.4em;
    cursor: pointer;
    letter-spacing: 0.04em;
    box-shadow: 0 6px 22px rgba(90, 209, 255, 0.26);
    transition: transform 0.12s, filter 0.2s;
  }

  .rp-start:hover { filter: brightness(1.08); }
  .rp-start:active { transform: translateY(1px); }

  .rp-start.is-running {
    background: rgba(255, 255, 255, 0.08);
    color: var(--ink);
    border: 1px solid var(--edge);
    box-shadow: none;
  }

  .rp-sync {
    font-family: inherit;
    font-size: 0.8em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--edge);
    border-radius: 9px;
    color: var(--ink);
    padding: 0.7em 1em;
    cursor: pointer;
  }

  .rp-sync:hover { background: rgba(255, 255, 255, 0.12); }

  .rp-vol { display: flex; align-items: center; gap: 9px; flex: 1 1 160px; min-width: 150px; }

  .rp-vol label,
  .rp-hint {
    font-size: 0.7em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .rp-hint { letter-spacing: 0.04em; text-transform: none; font-size: 0.85em; }

  .rp-block { border-top: 1px solid var(--edge); padding-top: 13px; }

  .rp-block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.7em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 10px;
  }

  .rp-value { color: var(--ink); font-variant-numeric: tabular-nums; }

  .rp-slider-wrap { position: relative; }

  .rp-boundary {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 2px;
    margin-left: -1px;
    background: linear-gradient(to bottom, rgba(255, 176, 32, 0), rgba(255, 176, 32, 0.85), rgba(255, 176, 32, 0));
    pointer-events: none;
    z-index: 2;
  }

  .rp-scale {
    position: relative;
    display: flex;
    justify-content: space-between;
    font-size: 0.66em;
    color: var(--faint);
    margin-top: 5px;
    height: 2.4em;
  }

  .rp-scale-mark {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    color: rgba(255, 176, 32, 0.8);
    white-space: nowrap;
    text-align: center;
    max-width: 46vw;
  }

  .rp-chips { display: flex; flex-wrap: wrap; gap: 7px; }

  .rp-chip {
    font-family: inherit;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--edge);
    border-radius: 8px;
    color: var(--ink);
    padding: 0.42em 0.7em;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    line-height: 1.2;
    transition: background 0.15s, border-color 0.15s;
  }

  .rp-chip:hover { background: rgba(255, 255, 255, 0.1); }
  .rp-chip.is-active { border-color: var(--v0); background: rgba(90, 209, 255, 0.14); }

  .chip-main { font-size: 0.76em; }
  .chip-sub { font-size: 0.66em; color: var(--faint); font-variant-numeric: tabular-nums; }
  .rp-chip.is-active .chip-sub { color: var(--v0); }

  /* ── Voice cards ── */
  .rp-voices { display: flex; flex-direction: column; gap: 9px; }

  .rp-vcard {
    border: 1px solid var(--edge);
    border-left: 3px solid var(--vc);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.035);
    padding: 9px 12px;
    transition: opacity 0.2s;
  }

  .rp-vcard.v0 { --vc: var(--v0); }
  .rp-vcard.v1 { --vc: var(--v1); }
  .rp-vcard.v2 { --vc: var(--v2); }
  .rp-vcard.v3 { --vc: var(--v3); }

  .rp-vcard.is-off { opacity: 0.4; }

  .rp-vhead { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

  .rp-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: 0 0 auto;
    background: var(--vc);
    box-shadow: 0 0 10px var(--vc);
  }

  .rp-vname { font-size: 0.85em; }

  .rp-vmeta {
    font-size: 0.66em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .rp-vtoggles { margin-left: auto; display: flex; gap: 5px; }

  .rp-toggle {
    font-family: inherit;
    font-size: 0.66em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--edge);
    border-radius: 6px;
    color: var(--dim);
    padding: 0.4em 0.7em;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .rp-toggle:hover { background: rgba(255, 255, 255, 0.1); }
  .rp-toggle.is-on { color: #04121a; background: var(--vc); border-color: var(--vc); }

  .rp-vread {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 5px 0 7px;
    flex-wrap: wrap;
  }

  .rp-vprimary {
    font-size: 1.1em;
    color: var(--vc);
    font-variant-numeric: tabular-nums;
  }

  .rp-vsecondary {
    font-size: 0.75em;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }

  .rp-vctrls { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }

  .rp-frac { display: flex; align-items: center; gap: 6px; }

  .rp-frac-label {
    font-size: 0.66em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .rp-frac-bar { color: var(--faint); }

  .rp-int {
    font-family: inherit;
    font-size: 0.85em;
    width: 3.4em;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--edge);
    border-radius: 6px;
    color: var(--ink);
    padding: 0.25em 0.4em;
    text-align: center;
  }

  .rp-int:focus { outline: 1px solid var(--vc); }

  .rp-detune { display: flex; align-items: center; gap: 8px; flex: 1 1 200px; min-width: 180px; }
  .rp-detune input[type="range"] { flex: 1 1 auto; }
  .rp-detune .rp-frac-label { white-space: nowrap; }

  .rp-dtreset {
    font-family: inherit;
    font-size: 0.85em;
    line-height: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--edge);
    border-radius: 6px;
    color: var(--dim);
    padding: 0.3em 0.5em;
    cursor: pointer;
    flex: 0 0 auto;
    transition: background 0.15s, color 0.15s, opacity 0.15s;
  }

  .rp-dtreset:hover:not(:disabled) { background: rgba(255, 255, 255, 0.12); color: var(--ink); }

  /* Nothing to undo at exactly zero, and saying so is the point. */
  .rp-dtreset:disabled { opacity: 0.25; cursor: default; }

  /* ── Range inputs ── */
  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    outline: none;
    margin: 0;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ink);
    border: 3px solid #05070f;
    box-shadow: 0 0 10px rgba(90, 209, 255, 0.55);
    cursor: pointer;
  }

  input[type="range"]::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--ink);
    border: 3px solid #05070f;
    box-shadow: 0 0 10px rgba(90, 209, 255, 0.55);
    cursor: pointer;
  }

  .rp-back {
    display: inline-block;
    margin-top: 18px;
    font-size: 0.8em;
    color: var(--faint);
    text-decoration: none;
    font-style: normal;
  }

  .rp-back:hover { color: var(--ink); }

  @media (max-width: 660px) {
    .rp-page { padding: 12px 8px 30px; }
    .rp-shell { padding: 18px 15px 15px; }
    .rp-stage { flex-direction: column; align-items: center; }
    .rp-rings { width: 100%; max-width: 300px; height: auto; aspect-ratio: 1; }
    .rp-summary { width: 100%; }
    .rp-strip { height: 150px; }
    .rp-vtoggles { margin-left: 0; width: 100%; }
    .rp-vmeta { font-size: 0.6em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-start { transition: none; }
  }
</style>

<script>
// ===========================================================================
// Rhythm → Pitch
// Up to four impulse trains over a shared root. Sweeping their common rate
// from 1 Hz to 440 Hz walks the same whole-number ratios from "polyrhythm" to
// "chord". Everything needing sample accuracy lives in an AudioWorklet; the
// main thread never sees more than ~60 messages a second.
// ===========================================================================

const N_VOICES = 4;

// --- Worklet source, compiled at runtime from a Blob URL so the page stays a
// --- single file with no extra build config. Plain JS: it is never parsed by
// --- TypeScript, and must avoid template literals so it survives this string.
const WORKLET_SRC = `
const NV = 4;
const TAU_REF = 0.014;   // decay time constant of the slowest pulse, seconds
const TAU_MIN = 0.0008;  // floor: keeps fast pulses distinct instead of smeared
const REPORT_EVERY = 6;  // render quanta between phase snapshots (~60 Hz)

// Per-voice character. Distinct bandpass seats and stereo positions are what
// keep four simultaneous trains from turning into one grey texture.
const V_FC    = [700, 1100, 1600, 2200];   // resonant bandpass centre, Hz
const V_PAN_L = [0.924, 0.809, 0.588, 0.383];
const V_PAN_R = [0.383, 0.588, 0.809, 0.924];
const V_TONE  = [0.55, 0.45, 0.38, 0.22];  // tonal share of the transient
const V_DECAY = [1.15, 1.0, 0.85, 0.6];    // D is a short, sharp pop

function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }

function makeVoice() {
  // ph: phase 0..1. env/envCoef: exponential amplitude decay. low/band:
  // Chamberlin state variable filter used as a resonant bandpass. op/oi: the
  // tonal part of the transient. exc: samples of noise burst still to come.
  return {
    ph: 0, env: 0, envCoef: 0, amp: 0, exc: 0,
    low: 0, band: 0, f1: 0, q1: 0.42, op: 0, oi: 0, tone: 0.5
  };
}

class RhythmPitchProcessor extends AudioWorkletProcessor {
  static get parameterDescriptors() {
    var ps = [];
    for (var i = 0; i < NV; i++) {
      ps.push({
        name: 'freq' + i, defaultValue: 2, minValue: 0.005, maxValue: 16000,
        automationRate: 'a-rate'
      });
      ps.push({
        name: 'gain' + i, defaultValue: i < 2 ? 1 : 0, minValue: 0, maxValue: 1,
        automationRate: 'k-rate'
      });
    }
    // 1/sqrt(N) headroom so adding voices does not step on the output level.
    ps.push({
      name: 'voiceScale', defaultValue: 1, minValue: 0.1, maxValue: 1,
      automationRate: 'k-rate'
    });
    ps.push({
      name: 'reportPulses', defaultValue: 1, minValue: 0, maxValue: 1,
      automationRate: 'k-rate'
    });
    return ps;
  }

  constructor() {
    super();
    this.v = [];
    for (var i = 0; i < NV; i++) this.v.push(makeVoice());
    this.quantum = 0;
    this.port.onmessage = function (e) {
      if (e.data && e.data.type === 'reset') {
        for (var k = 0; k < NV; k++) this.v[k].ph = 0;
      }
    }.bind(this);
  }

  // Arm one percussive impulse. Faster trains get shorter, quieter pulses so
  // the perceived loudness stays put as density climbs.
  fire(v, freq, i) {
    var tau = clamp(0.33 / freq, TAU_MIN, TAU_REF) * V_DECAY[i];
    tau = clamp(tau, TAU_MIN, 0.02);
    v.envCoef = Math.exp(-1 / (tau * sampleRate));
    v.env = 1;
    // A pulse train's RMS goes as amp * sqrt(freq * tau). Holding that
    // constant gives amp = sqrt(TAU_REF / (freq * tau)) -- which reduces to
    // the 1/sqrt(freq) rule while tau is still pinned at TAU_REF.
    v.amp = clamp(Math.sqrt(TAU_REF / (freq * tau)), 0.04, 1);
    v.exc = Math.max(2, Math.round(0.0012 * sampleRate));
    var fc = clamp(V_FC[i] + freq * 1.2, V_FC[i], V_FC[i] * 2.2);
    if (fc > sampleRate * 0.42) fc = sampleRate * 0.42;
    v.f1 = 2 * Math.sin(Math.PI * fc / sampleRate);
    v.oi = fc / sampleRate;
    v.op = 0;
    v.tone = V_TONE[i];
  }

  renderVoice(v) {
    if (v.env < 1e-5 && v.exc <= 0) { v.env = 0; return 0; }
    var exc = 0;
    if (v.exc > 0) { exc = Math.random() * 2 - 1; v.exc--; }
    v.low += v.f1 * v.band;
    var high = exc - v.low - v.q1 * v.band;
    v.band += v.f1 * high;
    var tone = Math.sin(6.283185307179586 * v.op);
    v.op += v.oi;
    if (v.op >= 1) v.op -= 1;
    var s = (v.band * 0.9 + tone * v.tone) * v.env * v.amp;
    v.env *= v.envCoef;
    return s;
  }

  process(inputs, outputs, params) {
    var out = outputs[0];
    if (!out || out.length === 0) return true;
    var L = out[0];
    var R = out.length > 1 ? out[1] : null;
    var n = L.length;
    var scale = 0.45 * params.voiceScale[0];
    var report = params.reportPulses[0] > 0.5;

    var fArr = [], gains = [], lastF = [], hits = [];
    for (var i = 0; i < NV; i++) {
      fArr.push(params['freq' + i]);
      gains.push(params['gain' + i][0]);
      lastF.push(params['freq' + i][0]);
      hits.push(0);
    }

    for (var s = 0; s < n; s++) {
      var mixL = 0, mixR = 0;
      for (var j = 0; j < NV; j++) {
        var fa = fArr[j];
        var f = fa.length > 1 ? fa[s] : fa[0];
        lastF[j] = f;
        var v = this.v[j];
        v.ph += f / sampleRate;
        if (v.ph >= 1) { v.ph -= 1; this.fire(v, f, j); hits[j]++; }
        var y = this.renderVoice(v) * gains[j];
        mixL += y * V_PAN_L[j];
        mixR += y * V_PAN_R[j];
      }
      if (R) { L[s] = mixL * scale; R[s] = mixR * scale; }
      else { L[s] = (mixL + mixR) * 0.5 * scale; }
    }

    this.quantum++;
    // Trigger messages only exist in the rhythm zone; above it the main thread
    // drives visuals off phase and the analyser instead.
    if (report) {
      var any = false;
      for (var h = 0; h < NV; h++) { if (hits[h]) { any = true; break; } }
      if (any) this.port.postMessage({ type: 'pulse', hits: hits });
    }
    if (this.quantum % REPORT_EVERY === 0) {
      var phases = [];
      for (var q = 0; q < NV; q++) phases.push(this.v[q].ph);
      // The phases are end-of-quantum values while currentTime marks the
      // quantum's start, so hand out the timestamp they actually belong to.
      // Frequencies go along too, so the main thread extrapolates from what
      // the audio really did rather than from its own target values.
      this.port.postMessage({
        type: 'phase', p: phases, f: lastF, t: currentTime + n / sampleRate
      });
    }
    return true;
  }
}

registerProcessor('rhythm-pitch', RhythmPitchProcessor);
`;

// ===== Constants =====
const F_MIN = 1;
const F_MAX = 440;
const LOG_SPAN = Math.log(F_MAX / F_MIN);
const BOUNDARY_HZ = 20;
// 64:1 over a 440 Hz root asks for 28 kHz, and a 1:64 ratio detuned by -0.05
// asks for a negative one. Both are clamped in freqOf(), the one place the
// audio and the readouts share, so they can never disagree about what sounds.
//
// The ceiling is not a taste call. A pulse train's onsets can only land on
// sample boundaries, so one sample of jitter is f/sr of a period; and above
// Nyquist the train cannot be represented at all (22.05 kHz on 44.1 kHz
// hardware, 24 kHz on 48 kHz). Quarter of the sample rate keeps at least four
// samples per period and stays clear of the fold-back, and 12 kHz caps it
// above the top of the musical range (C9 is 8372 Hz) where nothing useful is
// left anyway.
const F_FLOOR = 0.01;
const F_CEIL_MAX = 12000;
let fCeil = F_CEIL_MAX;   // narrowed once the context reports its sample rate
const SLIDER_STEPS = 1000;
const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const COLORS = ['#5ad1ff', '#ffb020', '#b98cff', '#4ee39b'];
const V_LABELS = ['A', 'B', 'C', 'D'];

// ===== DOM =====
function el<T extends HTMLElement>(id: string): T {
  return document.getElementById(id) as T;
}

const ringsCanvas = el<HTMLCanvasElement>('rings');
const stripCanvas = el<HTMLCanvasElement>('strip');
const rctx = ringsCanvas.getContext('2d')!;
const sctx = stripCanvas.getContext('2d')!;

const startBtn = el<HTMLButtonElement>('startBtn');
const syncBtn = el<HTMLButtonElement>('syncBtn');
const freqSlider = el<HTMLInputElement>('freqSlider');
const volSlider = el<HTMLInputElement>('volSlider');
const freqLabel = el<HTMLElement>('freqLabel');
const countLabel = el<HTMLElement>('countLabel');
const modeBadge = el<HTMLElement>('modeBadge');
const stripCaption = el<HTMLElement>('stripCaption');
const chordName = el<HTMLElement>('chordName');
const chordSub = el<HTMLElement>('chordSub');
const chordNotes = el<HTMLElement>('chordNotes');
const cycleInfo = el<HTMLElement>('cycleInfo');

const primEls = V_LABELS.map((_, i) => el<HTMLElement>('prim' + i));
const secEls = V_LABELS.map((_, i) => el<HTMLElement>('sec' + i));
const detEls = V_LABELS.map((_, i) => el<HTMLElement>('det' + i));

const q = <T extends HTMLElement>(sel: string) =>
  Array.from(document.querySelectorAll<T>(sel));

const freqChips = q<HTMLButtonElement>('.rp-chip[data-hz]');
const countChips = q<HTMLButtonElement>('.rp-chip-count');
const presetChips = q<HTMLButtonElement>('.rp-chip-preset');
const toggles = q<HTMLButtonElement>('.rp-toggle');
const intInputs = q<HTMLInputElement>('.rp-int');
const dtInputs = q<HTMLInputElement>('.rp-dt');
const dtResets = q<HTMLButtonElement>('.rp-dtreset');
const vcards = q<HTMLElement>('.rp-vcard');

// ===== Audio state =====
let ctx: AudioContext | null = null;
let node: AudioWorkletNode | null = null;
let analyser: AnalyserNode | null = null;
let master: GainNode | null = null;
let wave = new Float32Array(0);
let spectrum = new Uint8Array(0);
let running = false;
let booting = false;

// ===== Musical state =====
interface Voice {
  num: number;     // whole-number numerator of the ratio against the root
  den: number;     // whole-number denominator
  detune: number;  // additive offset to the ratio, +/- 0.05
  on: boolean;
  muted: boolean;
  solo: boolean;
}

let base = 2;    // root frequency, Hz
const voices: Voice[] = [
  { num: 1, den: 1, detune: 0, on: true,  muted: false, solo: false },
  { num: 5, den: 4, detune: 0, on: true,  muted: false, solo: false },
  { num: 3, den: 2, detune: 0, on: true,  muted: false, solo: false },
  { num: 7, den: 4, detune: 0, on: false, muted: false, solo: false },
];
let presetName = 'Major triad';

// ===== Visual state =====
let snapP: number[] = [0, 0, 0, 0];
let snapF: number[] = [2, 2, 2, 2];
let snapT = 0;
let live: number[] = [2, 2, 2, 2];   // frequencies as the worklet last saw them
const flash = [0, 0, 0, 0];
let alignFlash = 0;
let level = 0;
let dispPeak = 0.2;
let lastFrame = 0;
let readoutTick = 0;
let dpr = 1;

// ===== Helpers =====
function sliderToFreq(t: number): number {
  return F_MIN * Math.exp((LOG_SPAN * t) / SLIDER_STEPS);
}

function freqToSlider(f: number): number {
  return (SLIDER_STEPS * Math.log(f / F_MIN)) / LOG_SPAN;
}

function isPitch(): boolean {
  return base >= BOUNDARY_HZ;
}

function gcd(a: number, b: number): number {
  a = Math.abs(a); b = Math.abs(b);
  while (b) { const t = b; b = a % b; a = t; }
  return a || 1;
}

function lcm(a: number, b: number): number {
  return (a / gcd(a, b)) * b;
}

function ratioOf(v: Voice): number {
  return v.num / v.den + v.detune;
}

function rawFreqOf(i: number): number {
  return base * ratioOf(voices[i]);
}

function freqOf(i: number): number {
  return Math.min(fCeil, Math.max(F_FLOOR, rawFreqOf(i)));
}

function isClamped(i: number): boolean {
  const raw = rawFreqOf(i);
  return raw < F_FLOOR || raw > fCeil;
}

function activeIndices(): number[] {
  return voices.map((v, i) => (v.on ? i : -1)).filter((i) => i >= 0);
}

function activeCount(): number {
  return activeIndices().length;
}

function soundingCount(): number {
  let n = 0;
  for (let i = 0; i < N_VOICES; i++) if (gainFor(i) > 0) n++;
  return n;
}

function noteInfo(f: number): { name: string; cents: number } {
  const midi = 69 + 12 * Math.log2(f / 440);
  const nearest = Math.round(midi);
  const cents = Math.round((midi - nearest) * 100);
  const name = NOTE_NAMES[((nearest % 12) + 12) % 12] + (Math.floor(nearest / 12) - 1);
  return { name, cents };
}

function fmtCents(c: number): string {
  return (c >= 0 ? '+' : '') + c + '¢';
}

function fmtDetune(d: number): string {
  return (d >= 0 ? '+' : '−') + Math.abs(d).toFixed(3);
}

function gainFor(i: number): number {
  const v = voices[i];
  if (!v.on) return 0;
  const anySolo = voices.some((x) => x.on && x.solo);
  if (anySolo) return v.solo ? 1 : 0;
  return v.muted ? 0 : 1;
}

// How long until every active voice returns to its downbeat together, counted
// in root cycles. Uses the whole-number ratios only -- detune is exactly what
// breaks this, which is the point of the readout.
function commonCycle(): number {
  const idx = activeIndices();
  if (!idx.length) return 1;
  let d = 1;
  for (const i of idx) d = lcm(d, voices[i].den);
  let g = 0;
  for (const i of idx) g = gcd(g, voices[i].num * (d / voices[i].den));
  return d / (g || 1);
}

function detuned(): boolean {
  return activeIndices().some((i) => voices[i].detune !== 0);
}

// ===== Audio graph =====
async function buildGraph(): Promise<void> {
  const AC: typeof AudioContext =
    window.AudioContext ||
    (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
  const c = new AC();

  const url = URL.createObjectURL(new Blob([WORKLET_SRC], { type: 'application/javascript' }));
  try {
    await c.audioWorklet.addModule(url);
  } finally {
    URL.revokeObjectURL(url);
  }

  const nd = new AudioWorkletNode(c, 'rhythm-pitch', {
    numberOfInputs: 0,
    numberOfOutputs: 1,
    outputChannelCount: [2],
  });
  nd.port.onmessage = onWorkletMessage;

  // Compressor tames the peaks when several voices land on the same sample and
  // when hundreds of pulses a second start stacking up.
  const comp = c.createDynamicsCompressor();
  comp.threshold.value = -14;
  comp.knee.value = 8;
  comp.ratio.value = 6;
  comp.attack.value = 0.003;
  comp.release.value = 0.12;

  const g = c.createGain();
  g.gain.value = Number(volSlider.value) / 100;

  const an = c.createAnalyser();
  an.fftSize = 32768;
  an.smoothingTimeConstant = 0.6; // only affects the spectrum, not the scope

  nd.connect(comp);
  comp.connect(g);
  g.connect(c.destination);
  // Tap ahead of the fader so the visuals show the mix, not the listening
  // level; the analyser is a sink and feeds nothing onward.
  comp.connect(an);

  fCeil = Math.min(F_CEIL_MAX, c.sampleRate * 0.25);
  ctx = c;
  node = nd;
  master = g;
  analyser = an;
  wave = new Float32Array(an.fftSize);
  spectrum = new Uint8Array(an.frequencyBinCount);

  pushFreqs(true);
  pushGains(true);
}

function onWorkletMessage(e: MessageEvent): void {
  const d = e.data as { type: string; hits?: number[]; p?: number[]; f?: number[]; t?: number };
  if (d.type === 'pulse' && d.hits) {
    for (let i = 0; i < N_VOICES; i++) if (d.hits[i]) flash[i] = 1;
  } else if (d.type === 'phase' && d.p && d.f) {
    snapP = d.p;
    snapF = d.f;
    snapT = d.t ?? 0;
  }
}

function param(name: string): AudioParam | null {
  return node ? node.parameters.get(name) ?? null : null;
}

function setParam(
  p: AudioParam | null, v: number, immediate: boolean, at: number, tc = 0.02
): void {
  if (!p) return;
  p.cancelScheduledValues(at);
  if (immediate) p.setValueAtTime(v, at);
  else p.setTargetAtTime(v, at, tc);
}

function pushFreqs(immediate = false): void {
  if (!ctx || !node) return;
  // One timestamp for the whole set. Reading ctx.currentTime per voice lets
  // the clock cross a quantum boundary mid-loop, which starts some glides a
  // block later than others and leaves a phase offset that outlives the glide.
  const now = ctx.currentTime;
  for (let i = 0; i < N_VOICES; i++) {
    setParam(param('freq' + i), freqOf(i), immediate, now);
  }
  setParam(param('reportPulses'), isPitch() ? 0 : 1, true, now);
}

function pushGains(immediate = false): void {
  if (!ctx || !node) return;
  const now = ctx.currentTime;
  for (let i = 0; i < N_VOICES; i++) {
    setParam(param('gain' + i), gainFor(i), immediate, now, 0.012);
  }
  // Voices add incoherently, so total RMS grows as sqrt(N); back it off by the
  // same factor and the level holds steady from two voices up to four. Count
  // what is actually sounding, not what is enabled -- otherwise soloing one
  // voice out of four comes out ~3 dB under soloing it out of two.
  setParam(param('voiceScale'), Math.sqrt(2 / Math.max(2, soundingCount())), immediate, now, 0.03);
}

function resetPhase(): void {
  if (node) node.port.postMessage({ type: 'reset' });
  snapP = [0, 0, 0, 0];
  snapF = voices.map((_, i) => freqOf(i));
  snapT = ctx ? ctx.currentTime : 0;
  alignFlash = 1;
}

async function toggleEngine(): Promise<void> {
  if (booting) return;
  if (!ctx) {
    booting = true;
    startBtn.textContent = 'Starting…';
    try {
      await buildGraph();
    } catch (err) {
      startBtn.textContent = 'Audio unavailable';
      console.error('rhythm-to-pitch: could not start audio engine', err);
      booting = false;
      return;
    }
    booting = false;
  }
  if (!ctx) return;
  if (running) {
    await ctx.suspend();
    running = false;
  } else {
    await ctx.resume();
    resetPhase();
    running = true;
  }
  startBtn.textContent = running ? '❚❚ Stop engine' : '▶ Start engine';
  startBtn.classList.toggle('is-running', running);
}

// ===== Phase extrapolation =====
// The worklet reports ~60 times a second; between snapshots we advance the
// phases ourselves from the audio clock, which is what the pitch-mode visuals
// read instead of a flood of trigger messages.
function phaseAt(p0: number, f: number, dt: number): number {
  const p = (p0 + f * dt) % 1;
  return p < 0 ? p + 1 : p;
}

// ===== Canvas sizing =====
function sizeCanvas(cv: HTMLCanvasElement, c2d: CanvasRenderingContext2D): void {
  const rect = cv.getBoundingClientRect();
  const w = Math.max(1, Math.round(rect.width));
  const h = Math.max(1, Math.round(rect.height));
  dpr = Math.min(window.devicePixelRatio || 1, 2);
  if (cv.width !== w * dpr || cv.height !== h * dpr) {
    cv.width = w * dpr;
    cv.height = h * dpr;
  }
  c2d.setTransform(dpr, 0, 0, dpr, 0, 0);
}

// ===== Concentric rings =====
function drawRings(ph: number[]): void {
  sizeCanvas(ringsCanvas, rctx);
  const w = ringsCanvas.width / dpr;
  const h = ringsCanvas.height / dpr;
  const cx = w / 2;
  const cy = h / 2;
  const R = Math.min(w, h) / 2 - 10;
  rctx.clearRect(0, 0, w, h);

  const idx = activeIndices();
  const n = idx.length;

  idx.forEach((vi, slot) => {
    const t = n > 1 ? slot / (n - 1) : 0;
    const r = R * (0.88 - t * 0.56);
    track(cx, cy, r, ph[vi], COLORS[vi], flash[vi]);
  });

  // Centre: the chord, pulsing when every voice meets on the downbeat.
  const glow = 0.3 + alignFlash * 0.7;
  rctx.save();
  rctx.textAlign = 'center';
  rctx.textBaseline = 'middle';
  rctx.fillStyle = `rgba(232,236,245,${glow})`;
  const label = chordRatioShort();
  // Shrink once the ratio gets wordy so it never runs past the inner ring.
  const fit = Math.min(1, 11 / Math.max(11, label.length));
  rctx.font = `600 ${Math.round(R * 0.15 * fit)}px Maitree, serif`;
  rctx.fillText(label, cx, cy - R * 0.04);
  rctx.fillStyle = 'rgba(232,236,245,0.3)';
  rctx.font = `${Math.round(R * 0.088)}px Maitree, serif`;
  rctx.fillText(detuned() ? 'detuned · drifting' : `${n} voices`, cx, cy + R * 0.11);
  rctx.restore();
}

function track(
  cx: number, cy: number, r: number, phase: number, color: string, fl: number
): void {
  rctx.save();
  rctx.globalAlpha = 0.16 + fl * 0.5;
  rctx.beginPath();
  rctx.arc(cx, cy, r, 0, Math.PI * 2);
  rctx.strokeStyle = color;
  rctx.lineWidth = 1.5 + fl * 2.5;
  rctx.stroke();
  rctx.restore();

  // Home tick at 12 o'clock -- where each cycle begins.
  rctx.save();
  rctx.strokeStyle = color;
  rctx.globalAlpha = 0.45;
  rctx.lineWidth = 1.5;
  rctx.beginPath();
  rctx.moveTo(cx, cy - r - 4);
  rctx.lineTo(cx, cy - r + 4);
  rctx.stroke();
  rctx.restore();

  const ang = phase * Math.PI * 2 - Math.PI / 2;
  const x = cx + Math.cos(ang) * r;
  const y = cy + Math.sin(ang) * r;
  rctx.save();
  rctx.beginPath();
  rctx.arc(x, y, 3.5 + fl * 4, 0, Math.PI * 2);
  rctx.fillStyle = color;
  rctx.shadowColor = color;
  rctx.shadowBlur = 8 + fl * 20;
  rctx.fill();
  rctx.restore();
}

// The chord as whole numbers over a shared root. Coprime denominators can
// push that into the millions -- accurate but unreadable -- so past a limit
// fall back to listing each voice's own fraction.
function chordParts(): number[] {
  const idx = activeIndices();
  if (!idx.length) return [];
  let d = 1;
  for (const i of idx) d = lcm(d, voices[i].den);
  const parts = idx.map((i) => voices[i].num * (d / voices[i].den));
  let g = 0;
  for (const p of parts) g = gcd(g, p);
  return parts.map((p) => p / (g || 1));
}

function chordRatioText(): string {
  const idx = activeIndices();
  if (!idx.length) return '—';
  const parts = chordParts();
  if (parts.some((p) => p > 9999)) {
    return idx.map((i) => `${voices[i].num}:${voices[i].den}`).join(' · ');
  }
  return parts.join(':');
}

// Short enough to sit inside the ring without spilling over the edge.
function chordRatioShort(): string {
  const parts = chordParts();
  if (!parts.length) return '—';
  if (parts.some((p) => p > 9999)) return 'complex';
  return parts.join(':');
}

// ===== Waveform strip =====
function drawStrip(ph: number[]): void {
  sizeCanvas(stripCanvas, sctx);
  const w = stripCanvas.width / dpr;
  const h = stripCanvas.height / dpr;
  sctx.clearRect(0, 0, w, h);

  const idx = activeIndices();
  const laneTop = h * 0.74;           // trigger lanes live below the scope
  const scopeH = laneTop;
  const mid = scopeH * 0.5;

  sctx.save();
  sctx.strokeStyle = 'rgba(255,255,255,0.07)';
  sctx.lineWidth = 1;
  sctx.beginPath();
  sctx.moveTo(0, mid);
  sctx.lineTo(w, mid);
  sctx.moveTo(0, laneTop);
  sctx.lineTo(w, laneTop);
  sctx.stroke();
  sctx.restore();

  if (!ctx || !analyser) {
    sctx.save();
    sctx.fillStyle = 'rgba(232,236,245,0.28)';
    sctx.textAlign = 'center';
    sctx.textBaseline = 'middle';
    sctx.font = '13px Maitree, serif';
    sctx.fillText('Start the engine to see the pulse train', w / 2, mid);
    sctx.restore();
    return;
  }

  // Phase-lock to the lowest voice that is actually sounding -- anchoring to
  // an active-but-muted voice would leave the trace drifting.
  const audible = idx.filter((i) => gainFor(i) > 0);
  const ref = audible.length ? audible[0] : idx.length ? idx[0] : 0;
  const refF = Math.max(0.01, live[ref]);
  analyser.getFloatTimeDomainData(wave);
  const sr = ctx.sampleRate;
  const bufLen = wave.length;

  // Show ~2.5 cycles once they fit, otherwise as much history as we hold.
  const maxWin = Math.floor(bufLen * 0.75);
  const winN = Math.max(64, Math.min(maxWin, Math.round((2.5 / refF) * sr)));
  const periodN = sr / refF;

  // Lock the right edge to the reference voice's most recent trigger when
  // there is slack in the buffer, so fast waveforms sit still.
  let end = bufLen;
  if (periodN < bufLen - winN) {
    end = bufLen - Math.round((ph[ref] / refF) * sr);
    if (end < winN) end = winN;
    if (end > bufLen) end = bufLen;
  }
  const start = end - winN;
  const winSec = winN / sr;
  // The newest analyser sample trails the audio clock we extrapolate phase
  // from. Two render quanta is what this measures out to; it only nudges the
  // tick marks into line with the transients they mark.
  const edgeAgo = (bufLen - end) / sr + 256 / sr;

  // --- Spectrum underlay: above the boundary, what the chord is actually made
  // --- of is the interesting part.
  if (isPitch()) {
    analyser.getByteFrequencyData(spectrum);
    const topBin = Math.min(spectrum.length, Math.round((3200 / (sr / 2)) * spectrum.length));
    sctx.save();
    sctx.fillStyle = 'rgba(90,209,255,0.11)';
    for (let x = 0; x < w; x++) {
      const b0 = Math.floor((topBin * x) / w);
      const b1 = Math.max(b0 + 1, Math.floor((topBin * (x + 1)) / w));
      let m = 0;
      for (let b = b0; b < b1; b++) if (spectrum[b] > m) m = spectrum[b];
      const bh = (m / 255) * scopeH * 0.92;
      sctx.fillRect(x, scopeH - bh, 1, bh);
    }
    sctx.restore();
  }

  // --- Waveform. Wide windows get a per-column min/max envelope so transients
  // survive decimation; narrow ones are drawn as a plain polyline.
  let peak = 1e-4;
  for (let i = start; i < end; i += 8) {
    const v = Math.abs(wave[i]);
    if (v > peak) peak = v;
  }
  // Follow the peak so a sparse 1 Hz clap and a dense 440 Hz chord both fill
  // the strip; rising fast and falling slowly keeps it from pumping.
  dispPeak = peak > dispPeak ? peak : dispPeak * 0.92 + peak * 0.08;
  const amp = (scopeH * 0.4) / Math.max(0.02, dispPeak);

  let rms = 0;
  sctx.save();
  sctx.strokeStyle = 'rgba(232,236,245,0.85)';
  sctx.lineWidth = 1.25;
  sctx.beginPath();
  if (winN >= w) {
    for (let x = 0; x < w; x++) {
      const i0 = start + Math.floor((winN * x) / w);
      const i1 = Math.max(i0 + 1, start + Math.floor((winN * (x + 1)) / w));
      let mn = Infinity;
      let mx = -Infinity;
      for (let i = i0; i < i1; i++) {
        const v = wave[i];
        if (v < mn) mn = v;
        if (v > mx) mx = v;
        rms += v * v;
      }
      sctx.moveTo(x + 0.5, mid - mx * amp);
      sctx.lineTo(x + 0.5, mid - mn * amp);
    }
    rms = Math.sqrt(rms / winN);
  } else {
    for (let x = 0; x < w; x++) {
      const i = start + Math.min(winN - 1, Math.floor((winN * x) / w));
      const v = wave[i];
      rms += v * v;
      if (x === 0) sctx.moveTo(x, mid - v * amp);
      else sctx.lineTo(x, mid - v * amp);
    }
    rms = Math.sqrt(rms / w);
  }
  sctx.stroke();
  sctx.restore();
  level = level * 0.7 + Math.min(1, rms * 5) * 0.3;

  // --- Trigger lanes, one per active voice, drawn from the extrapolated
  // phases rather than from audio-rate messages. Watch them crowd together
  // and vanish into the wave.
  const laneH = (h - laneTop) / Math.max(1, idx.length);
  idx.forEach((vi, slot) => {
    const y0 = laneTop + slot * laneH + 1.5;
    const y1 = laneTop + (slot + 1) * laneH - 1.5;
    // A tinted band and a letter, so a sparse lane still says whose it is.
    sctx.save();
    sctx.globalAlpha = 0.07 + flash[vi] * 0.1;
    sctx.fillStyle = COLORS[vi];
    sctx.fillRect(0, y0, w, y1 - y0);
    sctx.restore();
    sctx.save();
    sctx.globalAlpha = 0.75;
    sctx.fillStyle = COLORS[vi];
    sctx.font = `${Math.min(11, Math.max(8, laneH * 0.8))}px Maitree, serif`;
    sctx.textAlign = 'left';
    sctx.textBaseline = 'middle';
    sctx.fillText(V_LABELS[vi], 5, (y0 + y1) / 2);
    sctx.restore();
    drawTicks(ph[vi], Math.max(0.01, live[vi]), COLORS[vi], y0, y1, w, winSec, edgeAgo);
  });

  sctx.save();
  sctx.fillStyle = 'rgba(232,236,245,0.3)';
  sctx.font = '10px Maitree, serif';
  sctx.textAlign = 'right';
  sctx.textBaseline = 'top';
  sctx.fillText(
    winSec >= 0.1 ? `${winSec.toFixed(2)} s window` : `${(winSec * 1000).toFixed(1)} ms window`,
    w - 8,
    4
  );
  sctx.restore();
}

function drawTicks(
  phase: number, f: number, color: string,
  yTop: number, yBot: number, w: number, winSec: number, edgeAgo: number
): void {
  const lag = phase / f; // seconds since that voice last fired
  sctx.save();
  sctx.strokeStyle = color;
  sctx.lineWidth = 1.5;
  sctx.globalAlpha = 0.8;
  sctx.beginPath();
  let drawn = 0;
  for (let k = 0; k < 600; k++) {
    const ago = lag + k / f;
    const xr = 1 - (ago - edgeAgo) / winSec;
    if (xr < 0) break;
    if (xr > 1) continue;
    const x = xr * w;
    sctx.moveTo(x, yTop);
    sctx.lineTo(x, yBot);
    if (++drawn > 400) break;
  }
  sctx.stroke();
  sctx.restore();
}

// ===== Readouts =====
function updateReadouts(): void {
  const pitch = isPitch();
  freqLabel.textContent = base < 10 ? `${base.toFixed(2)} Hz` : `${base.toFixed(1)} Hz`;
  countLabel.textContent = String(activeCount());

  modeBadge.textContent = pitch ? 'Pitch' : 'Rhythm';
  modeBadge.classList.toggle('is-pitch', pitch);
  modeBadge.classList.toggle('is-rhythm', !pitch);

  for (let i = 0; i < N_VOICES; i++) {
    const v = voices[i];
    const f = freqOf(i);
    const note = noteInfo(Math.max(0.01, f));
    // Every voice shows ratio, Hz, BPM and note; the mode only decides which
    // number gets the big type.
    const capped = !isClamped(i)
      ? ''
      : rawFreqOf(i) > fCeil
        ? ` · at ${(fCeil / 1000).toFixed(1)} kHz ceiling`
        : ' · at floor';
    const rg = gcd(v.num, v.den);
    const ratioTxt = rg > 1
      ? `${v.num}:${v.den} = ${v.num / rg}:${v.den / rg}`
      : `${v.num}:${v.den}`;
    if (pitch) {
      primEls[i].textContent = `${f.toFixed(2)} Hz`;
      secEls[i].textContent =
        `${note.name} ${fmtCents(note.cents)} · ${(f * 60).toFixed(0)} BPM · ` +
        `${ratioTxt}${capped}`;
    } else {
      primEls[i].textContent = `${(f * 60).toFixed(1)} BPM`;
      secEls[i].textContent =
        `${f.toFixed(3)} Hz · ${note.name} ${fmtCents(note.cents)} · ` +
        `${ratioTxt}${capped}`;
    }
    detEls[i].textContent = fmtDetune(v.detune);
  }

  const idx = activeIndices();
  chordName.textContent = presetName;
  chordSub.textContent = `${chordRatioText()} · ${idx.length} voices`;
  chordNotes.textContent = idx.length
    ? idx.map((i) => noteInfo(Math.max(0.01, freqOf(i))).name).join(' + ')
    : '—';

  const cyc = commonCycle();
  if (detuned()) {
    cycleInfo.textContent = 'never — detune breaks the lock';
  } else {
    const secs = cyc / base;
    const when = secs >= 3600
      ? `${(secs / 3600).toFixed(1)} h`
      : secs >= 60
        ? `${(secs / 60).toFixed(1)} min`
        : secs >= 1
          ? `${secs.toFixed(2)} s`
          : `${(secs * 1000).toFixed(0)} ms`;
    cycleInfo.textContent = `every ${cyc.toLocaleString()} root cycles · ${when}`;
  }

  stripCaption.textContent = pitch
    ? 'One continuous periodic waveform'
    : base > 12
      ? 'Ticks crowding toward a tone'
      : 'Separate clicks on a timeline';
}

// ===== Frame loop =====
function frame(ts: number): void {
  const dt = lastFrame ? Math.min(0.1, (ts - lastFrame) / 1000) : 0.016;
  lastFrame = ts;

  const ph = [0, 0, 0, 0];
  if (ctx) {
    const elapsed = Math.max(0, ctx.currentTime - snapT);
    for (let i = 0; i < N_VOICES; i++) {
      live[i] = snapF[i];
      ph[i] = phaseAt(snapP[i], live[i], elapsed);
    }
  }

  if (isPitch()) {
    // Too many triggers per frame to flash individually -- ride the envelope.
    for (let i = 0; i < N_VOICES; i++) flash[i] = gainFor(i) > 0 ? level * 0.8 : 0;
    alignFlash = Math.max(0, alignFlash - dt * 4);
  } else {
    for (let i = 0; i < N_VOICES; i++) flash[i] = Math.max(0, flash[i] - dt * 5);
    // Every active voice within a few ms of its downbeat at once: the moment
    // the whole polyrhythm restarts.
    const idx = activeIndices();
    const together = idx.length > 0 && idx.every((i) => {
      const d = Math.min(ph[i], 1 - ph[i]);
      return d / Math.max(0.01, live[i]) < 0.012;
    });
    alignFlash = together ? 1 : Math.max(0, alignFlash - dt * 2.5);
  }

  drawStrip(ph);
  drawRings(ph);

  if (++readoutTick % 6 === 0) updateReadouts();
  requestAnimationFrame(frame);
}

// ===== UI sync =====
function syncToggleUI(): void {
  for (const btn of toggles) {
    const i = Number(btn.dataset.voice);
    const act = btn.dataset.act;
    const v = voices[i];
    const on = act === 'on' ? v.on : act === 'mute' ? v.muted : v.solo;
    btn.classList.toggle('is-on', on);
    btn.setAttribute('aria-pressed', String(on));
  }
  vcards.forEach((card, i) => card.classList.toggle('is-off', !voices[i].on));
  for (const chip of countChips) {
    const on = Number(chip.dataset.count) === activeCount();
    chip.classList.toggle('is-active', on);
    chip.setAttribute('aria-pressed', String(on));
  }
}

function syncDetuneUI(): void {
  for (const btn of dtResets) {
    btn.disabled = voices[Number(btn.dataset.voice)].detune === 0;
  }
}

function syncRatioUI(): void {
  for (const input of intInputs) {
    const i = Number(input.dataset.voice);
    input.value = String(input.dataset.part === 'num' ? voices[i].num : voices[i].den);
  }
  for (const input of dtInputs) {
    input.value = String(voices[Number(input.dataset.voice)].detune);
  }
  syncDetuneUI();
}

function markFreqChips(): void {
  for (const chip of freqChips) {
    const hz = Number(chip.dataset.hz);
    const on = Math.abs(base - hz) < hz * 0.02;
    chip.classList.toggle('is-active', on);
    chip.setAttribute('aria-pressed', String(on));
  }
}

function markPresetChips(match: HTMLButtonElement | null): void {
  for (const chip of presetChips) {
    const on = chip === match;
    chip.classList.toggle('is-active', on);
    chip.setAttribute('aria-pressed', String(on));
  }
}

// A preset only stays "selected" while the ratios still match it exactly.
function refreshPresetMatch(): void {
  const idx = activeIndices();
  const found = presetChips.find((chip) => {
    const parts = (chip.dataset.parts ?? '').split(',').map(Number);
    if (parts.length !== idx.length) return false;
    return idx.every((vi, slot) => {
      const v = voices[vi];
      if (v.detune !== 0) return false;
      // a/b == c/d without reducing either side.
      return v.num * parts[0] === parts[slot] * v.den;
    });
  });
  markPresetChips(found ?? null);
  if (found) presetName = found.dataset.label ?? presetName;
  else presetName = detuned() ? 'Custom · detuned' : 'Custom ratio';
}

function applyAll(resetPhases: boolean): void {
  pushFreqs(resetPhases);
  pushGains();
  if (resetPhases) resetPhase();
  refreshPresetMatch();
  syncToggleUI();
  updateReadouts();
}

// ===== Wiring =====
startBtn.addEventListener('click', () => { void toggleEngine(); });
syncBtn.addEventListener('click', resetPhase);

freqSlider.addEventListener('input', () => {
  base = sliderToFreq(Number(freqSlider.value));
  pushFreqs();
  markFreqChips();
  updateReadouts();
});

volSlider.addEventListener('input', () => {
  if (master && ctx) {
    master.gain.setTargetAtTime(Number(volSlider.value) / 100, ctx.currentTime, 0.02);
  }
});

for (const chip of freqChips) {
  chip.addEventListener('click', () => {
    base = Number(chip.dataset.hz);
    freqSlider.value = String(freqToSlider(base));
    pushFreqs();
    markFreqChips();
    updateReadouts();
  });
}

for (const chip of countChips) {
  chip.addEventListener('click', () => {
    const n = Number(chip.dataset.count);
    voices.forEach((v, i) => { v.on = i < n; });
    applyAll(true);
  });
}

for (const chip of presetChips) {
  chip.addEventListener('click', () => {
    const parts = (chip.dataset.parts ?? '').split(',').map(Number);
    voices.forEach((v, i) => {
      v.on = i < parts.length;
      v.detune = 0;
      if (i < parts.length) {
        const g = gcd(parts[i], parts[0]);
        v.num = parts[i] / g;
        v.den = parts[0] / g;
      }
    });
    presetName = chip.dataset.label ?? 'Custom ratio';
    syncRatioUI();  // presets zero every detune, so this re-disables the resets
    applyAll(true);
  });
}

for (const btn of toggles) {
  btn.addEventListener('click', () => {
    const i = Number(btn.dataset.voice);
    const v = voices[i];
    switch (btn.dataset.act) {
      case 'on':
        // Two voices is the floor -- one train is not a polyrhythm.
        if (v.on && activeCount() <= 2) return;
        v.on = !v.on;
        applyAll(true);
        return;
      case 'mute': v.muted = !v.muted; break;
      default: v.solo = !v.solo; break;
    }
    pushGains();
    syncToggleUI();
    updateReadouts();
  });
}

for (const input of intInputs) {
  const commit = () => {
    const i = Number(input.dataset.voice);
    const isNum = input.dataset.part === 'num';
    const v = voices[i];
    const current = isNum ? v.num : v.den;
    const n = Math.round(Number(input.value));
    // Out-of-range or non-numeric input snaps back rather than silencing a voice.
    const safe = Number.isFinite(n) ? Math.min(64, Math.max(1, n)) : 1;
    input.value = String(safe);
    // change and blur both land on a real edit, and blur alone lands on a
    // click-in-click-out. Only an actual change should disturb the phases.
    if (safe === current) return;
    if (isNum) v.num = safe;
    else v.den = safe;
    applyAll(true);
  };
  input.addEventListener('change', commit);
  input.addEventListener('blur', commit);
}

function setDetune(i: number, d: number): void {
  voices[i].detune = Number.isFinite(d) ? d : 0;
  // No phase reset, even on a reset to zero: the voices have already drifted
  // apart, and snapping them back together is what Sync phase is for.
  pushFreqs();
  refreshPresetMatch();
  syncDetuneUI();
  updateReadouts();
}

for (const input of dtInputs) {
  input.addEventListener('input', () => {
    setDetune(Number(input.dataset.voice), Number(input.value));
  });
  // Double-click the slider as a shortcut for the same reset.
  input.addEventListener('dblclick', () => {
    setDetune(Number(input.dataset.voice), 0);
  });
}

for (const btn of dtResets) {
  btn.addEventListener('click', () => {
    const i = Number(btn.dataset.voice);
    // Match on the voice id rather than DOM order.
    const slider = dtInputs.find((x) => Number(x.dataset.voice) === i);
    if (slider) slider.value = '0';
    setDetune(i, 0);
  });
}

window.addEventListener('resize', () => {
  sizeCanvas(ringsCanvas, rctx);
  sizeCanvas(stripCanvas, sctx);
});

// ===== Boot =====
base = 2;
freqSlider.value = String(freqToSlider(base));
syncRatioUI();
markFreqChips();
refreshPresetMatch();
syncToggleUI();
updateReadouts();
requestAnimationFrame(frame);
</script>
