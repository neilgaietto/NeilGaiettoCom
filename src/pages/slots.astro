  .pick-tile:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 22px rgba(236, 72, 153, 0.5); }
  .pick-tile:disabled { cursor: default; }
  .pick-face { font-size: clamp(14px, 4vw, 20px); opacity: 0.65; letter-spacing: 1px; }

  .pick-reveal {
    position: absolute;
