  .pick-tile.spent { filter: saturate(0.35) brightness(0.65); }

  .pick-tile.t-prize { background: linear-gradient(150deg, #0891b2, #082f49); border-color: var(--cyan); }
  .pick-tile.t-prize .pick-reveal { color: #a5f3fc; }
  .pick-tile.t-mult { background: linear-gradient(150deg, #b45309, #451a03); border-color: var(--amber); }
  .pick-tile.t-mult .pick-reveal { color: #fde68a; }
  .pick-tile.t-end { background: linear-gradient(150deg, #7f1d1d, #1c0505); border-color: #ef4444; }
  .pick-tile.t-end .pick-reveal { color: #fca5a5; font-size: clamp(9px, 2.5vw, 12px); letter-spacing: 1px; }

  @keyframes flip { from { transform: rotateY(90deg) scale(0.85); } to { transform: none; } }

  /* ── Modal ── */
  .modal-card {
    width: 100%;
    max-width: 440px;
    text-align: center;
    padding: 26px 22px;
    border-radius: 18px;
