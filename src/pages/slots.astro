---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Token Mint — AI Slot Machine — NeilGaietto.com"
  description="Token Mint: a 5-reel, 20-line AI-themed video slot played entirely with AI tokens. Free spins, hold & spin token cache, prompt-pick bonus and four progressive jackpots."
>
  <div class="slot-page">
    <div class="cabinet">
      <div class="cab-top">
        <a href="/demos" class="icon-btn" aria-label="Back to demos">←</a>
        <div class="logo">
          <span class="logo-a">TOKEN</span><span class="logo-b">MINT</span>
          <span class="logo-sub">5 reels · 20 lines · 0 dollars</span>
        </div>
        <div class="top-actions">
          <button id="btn-sound" class="icon-btn" aria-label="Toggle sound">♪</button>
          <button id="btn-paytable" class="icon-btn" aria-label="Show paytable">?</button>
        </div>
      </div>

      <div class="jackpot-bar">
        <div class="jp jp-mini"><span class="jp-name">MINI</span><span class="jp-val" id="jp-MINI">0</span></div>
        <div class="jp jp-minor"><span class="jp-name">MINOR</span><span class="jp-val" id="jp-MINOR">0</span></div>
        <div class="jp jp-major"><span class="jp-name">MAJOR</span><span class="jp-val" id="jp-MAJOR">0</span></div>
        <div class="jp jp-grand"><span class="jp-name">GRAND</span><span class="jp-val" id="jp-GRAND">0</span></div>
      </div>

      <div class="stage">
        <canvas id="reels"></canvas>
        <div id="feature-bar" class="feature-bar hidden"></div>
        <div id="bigwin" class="bigwin hidden">
          <div class="bigwin-title" id="bigwin-title">BIG WIN</div>
          <div class="bigwin-amount" id="bigwin-amount">0</div>
        </div>
      </div>

      <div class="ticker" id="ticker">Press SPIN to mint some tokens</div>

      <div class="meters">
        <div class="meter">
          <span class="m-label">Tokens</span>
          <span class="m-val" id="m-balance">0</span>
        </div>
        <div class="meter meter-bet">
          <span class="m-label">Bet</span>
          <div class="bet-row">
            <button id="bet-down" class="bet-btn" aria-label="Lower bet">−</button>
            <span class="m-val" id="m-bet">0</span>
            <button id="bet-up" class="bet-btn" aria-label="Raise bet">+</button>
          </div>
        </div>
        <div class="meter">
          <span class="m-label">Win</span>
          <span class="m-val m-win" id="m-win">0</span>
        </div>
      </div>

      <div class="controls">
        <button id="btn-turbo" class="ctl ctl-small">⚡<small>TURBO</small></button>
        <button id="btn-spin" class="ctl ctl-spin">SPIN</button>
        <button id="btn-auto" class="ctl ctl-small">∞<small>AUTO</small></button>
      </div>
    </div>

    <!-- ── Paytable / help ── -->
    <div id="ov-paytable" class="overlay hidden" role="dialog" aria-modal="true"
         aria-labelledby="paytable-heading" aria-hidden="true">
      <div class="sheet">
        <button class="sheet-close" id="paytable-close" aria-label="Close">×</button>
        <h2 id="paytable-heading">Paytable</h2>
        <p class="sheet-note">
          Pays are shown for 3 / 4 / 5 of a kind, left to right on a line,
          multiplied by the <b>line bet</b> (total bet ÷ 20).
        </p>
        <div class="pt-grid" id="pt-grid"></div>

        <h3>Features</h3>
        <ul class="feat-list">
          <li><b class="c-gold">SINGULARITY (wild)</b> — reels 2, 3 &amp; 4. Substitutes for every
            paying symbol. Five wilds on a line is the top line pay.</li>
          <li><b class="c-cyan">INFERENCE (scatter)</b> — 3, 4 or 5 anywhere pay 2×, 10× or 50× total
            bet and launch <b>Free Inference</b>: 10/15/20 free spins. Every wild that lands sticks
            for the rest of the feature, and the win multiplier steps up ×1 for every 6 spins played
            (up to ×3). 3 scatters retrigger +5 more spins.</li>
          <li><b class="c-pink">PROMPT (bonus)</b> — 3 on reels 1, 3 &amp; 5 start <b>Prompt
            Engineering</b>: keep picking prompts for token prizes and a ×2 multiplier until four
            of them crash the run.</li>
          <li><b class="c-amber">TOKEN (coin)</b> — 6 or more anywhere trigger the <b>Token
            Cache</b> hold &amp; spin. Coins lock, you get 3 respins, and every new coin resets them.
            Collect ×2 upgrades, +1 respins and COLLECT coins. Fill all 15 positions for the
            <b>GRAND</b>.</li>
          <li><b class="c-green">OVERCLOCK</b> — a dead spin can randomly overclock the GPU and
            splash 2–4 extra wilds across the grid before the win is paid.</li>
          <li><b class="c-violet">SCATTER NUDGE</b> — land 2 scatters with a third teasing just off
            screen and the reel may nudge into place.</li>
        </ul>

        <h3>Jackpots</h3>
        <p class="sheet-note">
          Jackpots are held as multiples of your bet — MINI seeds at 20× your bet, MINOR 60×,
          MAJOR 300× and GRAND 800× — so each is worth the same number of bets at any stake.
          They creep up a little every spin until won, then drop back to the seed. Jackpot coins
          inside the Token Cache pay them out, and filling all 15 positions awards the GRAND.
        </p>

        <h3>Paylines</h3>
        <div class="lines-grid" id="lines-grid"></div>

        <p class="sheet-note sheet-foot">
          No real money, no purchases, nothing to win but bragging rights — the balance is a number
          in your browser. <button class="link-btn" id="btn-reset-progress">Reset my tokens &amp;
          jackpots</button>
        </p>
      </div>
    </div>

    <!-- ── Pick bonus ── -->
    <div id="ov-pick" class="overlay hidden" role="dialog" aria-modal="true"
         aria-labelledby="pick-heading" aria-hidden="true">
      <div class="pick-panel">
        <h2 class="pick-title" id="pick-heading">Prompt Engineering</h2>
        <p class="pick-sub" id="pick-sub">Pick a prompt. Four crashes end the run.</p>
        <div class="pick-meta">
          <div class="pick-stat"><span>Collected</span><b id="pick-total">0</b></div>
          <div class="pick-stat"><span>Multiplier</span><b id="pick-mult">×1</b></div>
          <div class="pick-stat"><span>Crashes</span><b id="pick-ends">0 / 4</b></div>
        </div>
        <div class="pick-grid" id="pick-grid">
          {Array.from({ length: 12 }).map((_, i) => (
            <button class="pick-tile" data-i={i}>
              <span class="pick-face">&gt;_</span>
              <span class="pick-reveal"></span>
            </button>
          ))}
        </div>
        <button class="ctl ctl-modal hidden" id="pick-done">COLLECT</button>
      </div>
    </div>

    <!-- ── Generic feature modal ── -->
    <div id="ov-modal" class="overlay hidden" role="dialog" aria-modal="true"
         aria-labelledby="modal-title" aria-hidden="true">
      <div class="modal-card">
        <div class="modal-kicker" id="modal-kicker"></div>
        <h2 class="modal-title" id="modal-title"></h2>
        <p class="modal-body" id="modal-body"></p>
        <div class="modal-amount hidden" id="modal-amount"></div>
        <button class="ctl ctl-modal" id="modal-btn">CONTINUE</button>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  html {
    background: #05030f;
  }

  /* The cabinet is a dark neon object, so it sits on a dark room rather than the
     site's photo backdrop. */
  body {
    align-items: stretch !important;
    justify-content: stretch !important;
    padding: 0;
    background-color: #05030f !important;
    background-image:
      radial-gradient(ellipse 90% 55% at 50% -8%, rgba(124, 58, 237, 0.34), transparent 70%),
      radial-gradient(ellipse 65% 45% at 8% 100%, rgba(34, 211, 238, 0.16), transparent 70%),
      radial-gradient(ellipse 65% 45% at 92% 92%, rgba(236, 72, 153, 0.16), transparent 70%),
      linear-gradient(180deg, #0a0618 0%, #05030f 55%, #09051c 100%) !important;
    background-attachment: fixed !important;
  }

  .slot-page {
    --bg: #05030f;
    --cyan: #22d3ee;
    --violet: #a855f7;
    --pink: #ec4899;
    --amber: #fbbf24;
    --green: #34d399;
    --mono: ui-monospace, "SF Mono", "Roboto Mono", Menlo, Consolas, monospace;

    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 100vh;
    padding: 10px;
    font-family: var(--mono);
  }

  .slot-page .hidden { display: none !important; }

  .slot-page .c-gold { color: var(--amber); }
  .slot-page .c-cyan { color: var(--cyan); }
  .slot-page .c-pink { color: var(--pink); }
  .slot-page .c-amber { color: var(--amber); }
  .slot-page .c-green { color: var(--green); }
  .slot-page .c-violet { color: var(--violet); }

  /* ── Cabinet ── */
  .cabinet {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    border-radius: 18px;
    background: linear-gradient(170deg, rgba(16, 10, 40, 0.92), rgba(4, 3, 15, 0.95));
    border: 1px solid rgba(168, 85, 247, 0.35);
    box-shadow:
      0 0 0 1px rgba(34, 211, 238, 0.12),
      0 0 70px rgba(120, 60, 220, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .cab-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .logo {
    text-align: center;
    line-height: 1;
    flex: 1;
  }

  .logo-a, .logo-b {
    font-size: clamp(18px, 4.4vw, 26px);
    font-weight: 700;
    letter-spacing: 3px;
  }

  .logo-a {
    background: linear-gradient(90deg, #22d3ee, #818cf8);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .logo-b {
    background: linear-gradient(90deg, #e879f9, #fbbf24);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .logo-sub {
    display: block;
    margin-top: 4px;
    font-size: 9px;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .top-actions { display: flex; gap: 6px; }

  .icon-btn {
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 9px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-family: var(--mono);
    font-size: 15px;
    font-style: normal;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .icon-btn:hover { background: rgba(255, 255, 255, 0.14); border-color: rgba(34, 211, 238, 0.5); }
  .icon-btn.off { opacity: 0.4; }

  /* ── Jackpot bar ── */
  .jackpot-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5px;
  }

  .jp {
    text-align: center;
    padding: 5px 2px 4px;
    border-radius: 9px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    overflow: hidden;
  }

  .jp-name {
    display: block;
    font-size: 8.5px;
    letter-spacing: 2px;
    opacity: 0.6;
  }

  .jp-val {
    display: block;
    font-size: clamp(11px, 2.7vw, 15px);
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .jp-mini  { border-color: rgba(52, 211, 153, 0.4); }
  .jp-mini  .jp-val { color: var(--green); }
  .jp-minor { border-color: rgba(34, 211, 238, 0.4); }
  .jp-minor .jp-val { color: var(--cyan); }
  .jp-major { border-color: rgba(168, 85, 247, 0.45); }
  .jp-major .jp-val { color: #c084fc; }
  .jp-grand { border-color: rgba(251, 191, 36, 0.55); background: rgba(251, 191, 36, 0.07); }
  .jp-grand .jp-val { color: var(--amber); }

  .jp.flash { animation: jpflash 0.5s ease-in-out 6; }
  @keyframes jpflash {
    0%, 100% { background: rgba(255, 255, 255, 0.04); }
    50% { background: rgba(251, 191, 36, 0.45); }
  }

  /* ── Stage ── */
  .stage {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #070512;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stage canvas { display: block; width: 100%; }

  .feature-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 5px 10px;
    font-size: clamp(9px, 2.3vw, 12px);
    letter-spacing: 1.2px;
    text-transform: uppercase;
    background: linear-gradient(90deg, rgba(168, 85, 247, 0.85), rgba(236, 72, 153, 0.75));
    box-shadow: 0 2px 14px rgba(168, 85, 247, 0.5);
  }

  .feature-bar b { font-weight: 700; }

  .bigwin {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 4px;
    text-align: center;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(10, 0, 30, 0.72), rgba(5, 3, 15, 0.35) 70%, transparent);
  }

  .bigwin-title {
    font-size: clamp(20px, 6.5vw, 40px);
    font-weight: 700;
    letter-spacing: 4px;
    background: linear-gradient(90deg, #fbbf24, #f472b6, #22d3ee, #fbbf24);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 2.2s linear infinite, pop 0.45s cubic-bezier(0.2, 1.6, 0.4, 1);
    text-shadow: 0 0 26px rgba(251, 191, 36, 0.35);
  }

  .bigwin-amount {
    font-size: clamp(24px, 8vw, 52px);
    font-weight: 700;
    color: #fff;
    text-shadow: 0 0 24px rgba(34, 211, 238, 0.8), 0 0 60px rgba(168, 85, 247, 0.6);
  }

  @keyframes shimmer { to { background-position: 300% 0; } }
  @keyframes pop { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }

  /* ── Ticker ── */
  .ticker {
    text-align: center;
    font-size: clamp(10px, 2.6vw, 12.5px);
    letter-spacing: 1.4px;
    text-transform: uppercase;
    padding: 4px 6px;
    min-height: 22px;
    color: rgba(255, 255, 255, 0.72);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.035);
  }

  .ticker.hot { color: var(--amber); text-shadow: 0 0 14px rgba(251, 191, 36, 0.6); }

  /* ── Meters ── */
  .meters {
    display: grid;
    grid-template-columns: 1fr 1.25fr 1fr;
    gap: 6px;
  }

  .meter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 6px 4px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }

  .m-label {
    font-size: 8.5px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .m-val {
    font-size: clamp(14px, 3.6vw, 19px);
    font-weight: 700;
    letter-spacing: 0.5px;
    font-variant-numeric: tabular-nums;
  }

  .m-win { color: var(--amber); }
  .m-win.rolling { text-shadow: 0 0 16px rgba(251, 191, 36, 0.85); }

  .bet-row { display: flex; align-items: center; gap: 6px; }

  .bet-btn {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
  }

  .bet-btn:hover:not(:disabled) { background: rgba(34, 211, 238, 0.22); }
  .bet-btn:disabled { opacity: 0.3; cursor: default; }

  /* ── Controls ── */
  .controls {
    display: grid;
    grid-template-columns: 1fr 1.9fr 1fr;
    gap: 8px;
    align-items: center;
  }

  .ctl {
    font-family: var(--mono);
    font-weight: 700;
    color: #fff;
    border-radius: 12px;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.07);
    transition: transform 0.08s, box-shadow 0.2s, background 0.2s;
  }

  .ctl:active:not(:disabled) { transform: scale(0.96); }
  .ctl:disabled { opacity: 0.45; cursor: default; }

  .ctl-small {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 7px 4px;
    font-size: 14px;
    letter-spacing: 1px;
  }

  .ctl-small small { font-size: 8px; letter-spacing: 1.5px; opacity: 0.65; }
  .ctl-small.on {
    background: rgba(34, 211, 238, 0.25);
    border-color: var(--cyan);
    box-shadow: 0 0 18px rgba(34, 211, 238, 0.45);
  }

  .ctl-spin {
    padding: 14px 8px;
    font-size: clamp(16px, 4.2vw, 21px);
    letter-spacing: 5px;
    background: linear-gradient(135deg, #7c3aed, #db2777 60%, #f59e0b);
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 0 26px rgba(219, 39, 119, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .ctl-spin:hover:not(:disabled) { box-shadow: 0 0 38px rgba(219, 39, 119, 0.75); }
  .ctl-spin.stopmode { background: linear-gradient(135deg, #334155, #64748b); letter-spacing: 4px; }

  /* ── Overlays ── */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    padding: 14px;
    background: rgba(3, 2, 10, 0.86);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    overflow-y: auto;
  }

  .sheet {
    position: relative;
    width: 100%;
    max-width: 640px;
    max-height: 88vh;
    overflow-y: auto;
    padding: 18px 20px 24px;
    border-radius: 16px;
    background: linear-gradient(170deg, rgba(20, 12, 45, 0.98), rgba(6, 4, 18, 0.98));
    border: 1px solid rgba(168, 85, 247, 0.4);
    text-align: left;
    font-size: 13px;
    line-height: 1.55;
  }

  .sheet h2 { margin: 0 0 6px; font-size: 20px; letter-spacing: 3px; }
  .sheet h3 { margin: 20px 0 6px; font-size: 13px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--cyan); font-weight: 700; }
  .sheet-note { margin: 0 0 10px; font-size: 12px; opacity: 0.7; line-height: 1.5; }
  .sheet-foot { margin-top: 18px; }

  .sheet-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }

  .pt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 7px;
  }

  .pt-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pt-row canvas { width: 34px; height: 34px; flex: 0 0 auto; }
  .pt-info { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .pt-name { font-size: 9.5px; letter-spacing: 1.4px; text-transform: uppercase; opacity: 0.65; }
  .pt-pays { font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .pt-special { font-size: 10px; opacity: 0.8; letter-spacing: 0.6px; }

  .feat-list { margin: 0; padding-left: 18px; font-size: 12px; line-height: 1.6; }
  .feat-list li { margin-bottom: 7px; }

  .lines-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(58px, 1fr));
    gap: 5px;
  }

  .line-mini {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 1.5px;
    padding: 4px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    aspect-ratio: 5 / 3.4;
  }

  .line-mini i { border-radius: 2px; background: rgba(255, 255, 255, 0.09); }
  .line-mini i.on { background: currentColor; box-shadow: 0 0 6px currentColor; }

  .link-btn {
    background: none;
    border: none;
    padding: 0;
    color: var(--cyan);
    font-family: var(--mono);
    font-size: 12px;
    text-decoration: underline;
    cursor: pointer;
  }

  /* ── Pick bonus ── */
  .pick-panel {
    width: 100%;
    max-width: 560px;
    text-align: center;
    padding: 18px 16px 22px;
    border-radius: 18px;
    background: linear-gradient(165deg, rgba(48, 12, 60, 0.96), rgba(9, 4, 24, 0.98));
    border: 1px solid rgba(236, 72, 153, 0.45);
    box-shadow: 0 0 60px rgba(236, 72, 153, 0.28);
  }

  .pick-title {
    margin: 0;
    font-size: clamp(19px, 5vw, 27px);
    letter-spacing: 3px;
    background: linear-gradient(90deg, #f472b6, #fbbf24);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pick-sub { margin: 6px 0 12px; font-size: 12px; opacity: 0.75; letter-spacing: 0.6px; }

  .pick-meta { display: flex; justify-content: center; gap: 10px; margin-bottom: 12px; }

  .pick-stat {
    flex: 1;
    max-width: 130px;
    padding: 5px 4px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
  }

  .pick-stat span { font-size: 8.5px; letter-spacing: 1.8px; text-transform: uppercase; opacity: 0.55; }
